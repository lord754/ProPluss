<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRO+ Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" href="/favicon.ico">
    <style>
        .dashboard-container {
            position: relative;
        }

        /* Ensure relative context */

        .logout-btn {
            position: absolute;
            top: 25px;
            right: 25px;
            color: #e74c3c;
            text-decoration: none;
            font-weight: bold;
            background: rgba(231, 76, 60, 0.1);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid rgba(231, 76, 60, 0.3);
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 5px;
            z-index: 10;
            font-size: 0.9rem;
        }

        .logout-btn:hover {
            background: #e74c3c;
            color: #fff;
        }

        @media (max-width: 768px) {
            .logout-btn {
                top: 15px;
                right: 15px;
                padding: 6px 12px;
                font-size: 0.8rem;
            }
            .logout-text { display: none; }
        }

        /* ── Status Rotator Panel (right-section) ──────────────────── */
        .right-section { padding: 20px 10px 20px 0; }
        .rotator-panel { display: flex; flex-direction: column; gap: 14px; }
        .rotator-title { font-size: 1rem; font-weight: 800; color: #a29bfe; letter-spacing: .4px; margin-bottom: 4px; }
        .rotator-card {
            background: #111116;
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 16px;
            padding: 18px 20px;
        }
        .rotator-card-title {
            font-size: .82rem; font-weight: 700; color: #ccc;
            margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
        }
        .rotator-input, .rotator-inp {
            width: 100%; padding: 9px 12px;
            background: #050508; border: 1px solid rgba(255,255,255,0.08);
            color: #fff; border-radius: 9px; outline: none;
            font-family: 'Outfit', sans-serif; font-size: .84rem;
            margin-bottom: 10px; transition: .2s;
            resize: vertical;
        }
        .rotator-input:focus, .rotator-inp:focus { border-color: #8a2be2; }
        .rotator-input::placeholder, .rotator-inp::placeholder { color: #333; }
        .rotator-num {
            width: 60px; padding: 7px 10px;
            background: #050508; border: 1px solid rgba(255,255,255,0.08);
            color: #fff; border-radius: 8px; outline: none; font-size: .84rem;
            font-family: 'Outfit', sans-serif;
        }
        .rotator-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
        .rbtn {
            padding: 7px 16px; border: none; border-radius: 8px;
            font-weight: 700; cursor: pointer; font-size: .78rem;
            font-family: 'Outfit', sans-serif; transition: .2s;
        }
        .rbtn-on  { background: linear-gradient(90deg,#8a2be2,#6c5ce7); color: #fff; }
        .rbtn-on:hover  { filter: brightness(1.15); }
        .rbtn-off { background: rgba(231,76,60,0.1); color: #e74c3c; border: 1px solid rgba(231,76,60,0.2); }
        .rbtn-off:hover { background: #e74c3c; color: #fff; }
        .rbtn-idle { background: rgba(243,156,18,0.1); color: #f39c12; border: 1px solid rgba(243,156,18,0.2); }
        .rbtn-idle:hover { background: #f39c12; color: #fff; }
        .rbtn-dnd  { background: rgba(231,76,60,0.1); color: #e74c3c; border: 1px solid rgba(231,76,60,0.2); }
        .rbtn-dnd:hover { background: #e74c3c; color: #fff; }
        .rbadge {
            font-size: .66rem; font-weight: 800; padding: 2px 8px;
            border-radius: 8px; text-transform: uppercase; letter-spacing: .4px;
        }
        .rbadge-on  { background: rgba(46,204,113,0.12); color: #2ecc71; border: 1px solid rgba(46,204,113,0.25); }
        .rbadge-off { background: rgba(255,255,255,0.05); color: #555; border: 1px solid rgba(255,255,255,0.08); }
        .rotator-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
        .rotator-tag {
            background: #1a1a2e; border: 1px solid rgba(138,43,226,0.25);
            border-radius: 20px; padding: 3px 10px; font-size: .75rem; color: #a29bfe;
        }
        @media (max-width: 900px) { .right-section { padding: 0 0 20px; } }
    </style>
</head>

<body>

    <div class="dashboard-container home-container">
        <!-- Logout Button Inside Container -->
        <a href="/logout" class="logout-btn">
            <i class="fas fa-sign-out-alt"></i> <span class="logout-text">Logout</span>
        </a>

        <div class="left-section">
            <div class="profile-section">
                <% let strokeClass='stroke-offline' ; if(status==='online' ) strokeClass='stroke-online' ;
                    if(status==='idle' ) strokeClass='stroke-idle' ; if(status==='dnd' ) strokeClass='stroke-dnd' ; %>

                    <div class="avatar-wrapper <%= strokeClass %>">
                        <img src="<%= user.displayAvatarURL({ format: 'png', dynamic: true, size: 512 }) %>"
                            alt="Avatar" class="avatar">
                    </div>
            </div>

            <div style="text-align: center;">
                <h1 class="username">
                    <%= user.username %>
                        <span class="discriminator">#<%= user.discriminator %></span>
                </h1>

                <div class="uptime-section">
                    <div class="title">System Uptime</div>
                    <div class="uptime-badge">
                        Loading...
                    </div>
                </div>
            </div>

            <hr class="divider">

            <form id="statusForm" action="/update-status" method="POST" class="settings-form">
                <div class="form-group">
                    <label>Status Mode</label>
                    <div class="status-options">
                        <label class="radio-label">
                            <input type="radio" name="status" value="online" <%=status==='online' ? 'checked' : '' %>>
                            <span class="radio-btn online">Online</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="status" value="idle" <%=status==='idle' ? 'checked' : '' %>>
                            <span class="radio-btn idle">Idle</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="status" value="dnd" <%=status==='dnd' ? 'checked' : '' %>>
                            <span class="radio-btn dnd">DND</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="status" value="invisible" <%=status==='invisible' ? 'checked' : ''
                                %>>
                            <span class="radio-btn offline">Invisible</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Custom Message</label>
                    <input type="text" name="custom_status" class="input-field" placeholder="Playing with code..."
                        value="<%= currentActivity %>">
                </div>

                <div class="form-group">
                    <label>Emoji (Nitro Support)</label>
                    <input type="text" name="emoji" class="input-field" placeholder="🍕 or <:name:id>"
                        value="<%= currentEmoji %>">
                    <small class="hint">Paste emoji or use ID format for custom ones</small>
                </div>

                <button type="submit" id="updateStatusBtn" class="save-btn">Update Status</button>
            </form>
        </div>

        <div class="right-section">
            <!-- ── Status Rotator Panel ─────────────────────────────────── -->
            <div class="rotator-panel">
                <div class="rotator-title">⚡ Status Rotator</div>

                <div class="rotator-card">
                    <div class="rotator-card-title">🔁 Status Rotation <span class="rbadge rbadge-off" id="rStatusBadge">OFF</span></div>
                    <textarea class="rotator-input" id="rStatusList" rows="3" placeholder="Playing games, Watching anime, Coding..."></textarea>
                    <div class="rotator-row">
                        <div style="display:flex;align-items:center;gap:6px">
                            <span style="color:#666;font-size:.78rem">Delay (s)</span>
                            <input type="number" id="rStatusDelay" class="rotator-num" value="8" min="3">
                        </div>
                        <div style="display:flex;gap:6px">
                            <button class="rbtn rbtn-on" onclick="rStartStatus()">Start</button>
                            <button class="rbtn rbtn-off" onclick="rStopStatus()">Stop</button>
                        </div>
                    </div>
                    <div id="rStatusTags" class="rotator-tags"></div>
                </div>

                <div class="rotator-card">
                    <div class="rotator-card-title">😀 Emoji Rotation <span class="rbadge rbadge-off" id="rEmojiBadge">OFF</span></div>
                    <input type="text" class="rotator-inp" id="rEmojiList" placeholder="😎, 🔥, 💀, 🎮">
                    <div class="rotator-row">
                        <div style="display:flex;align-items:center;gap:6px">
                            <span style="color:#666;font-size:.78rem">Delay (s)</span>
                            <input type="number" id="rEmojiDelay" class="rotator-num" value="8" min="3">
                        </div>
                        <div style="display:flex;gap:6px">
                            <button class="rbtn rbtn-on" onclick="rStartEmoji()">Start</button>
                            <button class="rbtn rbtn-off" onclick="rStopEmoji()">Stop</button>
                        </div>
                    </div>
                </div>

                <div class="rotator-card">
                    <div class="rotator-card-title">📡 Stream Status <span class="rbadge rbadge-off" id="rStreamBadge">OFF</span></div>
                    <input type="text" class="rotator-inp" id="rStreamList" placeholder="Playing Valorant, Grinding ranked...">
                    <div style="display:flex;gap:6px;margin-top:4px">
                        <button class="rbtn rbtn-on" onclick="rStartStream()">Start</button>
                        <button class="rbtn rbtn-off" onclick="rStopStream()">Stop</button>
                    </div>
                </div>
        </div>
    </div>

    <script>
        let uptimeSeconds = <%= uptimeSeconds %>;

        function updateUptime() {
            uptimeSeconds++;
            let diff = uptimeSeconds;

            let days = Math.floor(diff / 86400);
            diff %= 86400;
            let hours = Math.floor(diff / 3600);
            diff %= 3600;
            let minutes = Math.floor(diff / 60);
            let seconds = Math.floor(diff % 60);

            const uptimeStr = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            document.querySelector('.uptime-badge').innerText = uptimeStr;
        }

        setInterval(updateUptime, 1000);
        updateUptime(); // Initial call

        // AJAX Status Update
        document.getElementById('statusForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('updateStatusBtn');
            const originalText = btn.innerText;

            // Visual feedback - Loading? Optional, but let's go straight to success handling if fast.
            // But let's disable to prevent double click
            btn.disabled = true;

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/update-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    btn.style.transition = 'background-color 0.3s';
                    btn.style.backgroundColor = '#43b581'; // Discord Green
                    btn.innerText = 'Saved!';

                    setTimeout(() => {
                        btn.style.backgroundColor = ''; // Revert to CSS default
                        btn.innerText = originalText;
                        btn.disabled = false;
                    }, 2000);
                } else {
                    alert('Failed to save status.');
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('Error saving status.');
                btn.disabled = false;
            }
        });
    </script>

<script>
// ── Status Rotator (right panel) ──────────────────────────────────────────────
let rStatusTimer = null, rEmojiTimer = null, rStreamTimer = null;

async function rApi(path, body) {
    try {
        const r = await fetch(path, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        return r.json();
    } catch(e) { return { success: false }; }
}

function rRenderTags(id, items) {
    const c = document.getElementById(id);
    if (!c) return;
    c.innerHTML = items.map(t => `<div class="rotator-tag">${t}</div>`).join('');
}

async function rStartStatus() {
    const raw = document.getElementById('rStatusList').value;
    const list = raw.split(',').map(s=>s.trim()).filter(Boolean);
    const delay = parseInt(document.getElementById('rStatusDelay').value) || 8;
    if (!list.length) return;
    if (rStatusTimer) clearInterval(rStatusTimer);
    rRenderTags('rStatusTags', list);
    const badge = document.getElementById('rStatusBadge');
    badge.className = 'rbadge rbadge-on'; badge.textContent = 'ON';
    let idx = 0;
    const tick = () => rApi('/api/status-rotator/set', { text: list[idx++ % list.length] });
    await tick();
    rStatusTimer = setInterval(tick, delay * 1000);
}

function rStopStatus() {
    if (rStatusTimer) { clearInterval(rStatusTimer); rStatusTimer = null; }
    const badge = document.getElementById('rStatusBadge');
    badge.className = 'rbadge rbadge-off'; badge.textContent = 'OFF';
    rApi('/api/status-rotator/set', { text: '' });
    document.getElementById('rStatusTags').innerHTML = '';
}

async function rStartEmoji() {
    const raw = document.getElementById('rEmojiList').value;
    const list = raw.split(',').map(s=>s.trim()).filter(Boolean);
    const delay = parseInt(document.getElementById('rEmojiDelay').value) || 8;
    if (!list.length) return;
    if (rEmojiTimer) clearInterval(rEmojiTimer);
    const badge = document.getElementById('rEmojiBadge');
    badge.className = 'rbadge rbadge-on'; badge.textContent = 'ON';
    let idx = 0;
    const tick = () => rApi('/api/status-rotator/emoji', { emoji: list[idx++ % list.length] });
    await tick();
    rEmojiTimer = setInterval(tick, delay * 1000);
}

function rStopEmoji() {
    if (rEmojiTimer) { clearInterval(rEmojiTimer); rEmojiTimer = null; }
    const badge = document.getElementById('rEmojiBadge');
    badge.className = 'rbadge rbadge-off'; badge.textContent = 'OFF';
}

function rSetStatus(s) { rApi('/api/status-rotator/online-status', { status: s }); }

async function rStartStream() {
    const raw = document.getElementById('rStreamList').value;
    const list = raw.split(',').map(s=>s.trim()).filter(Boolean);
    if (!list.length) return;
    if (rStreamTimer) clearInterval(rStreamTimer);
    const badge = document.getElementById('rStreamBadge');
    badge.className = 'rbadge rbadge-on'; badge.textContent = 'ON';
    let idx = 0;
    const tick = () => rApi('/api/status-rotator/stream', { name: list[idx++ % list.length] });
    await tick();
    rStreamTimer = setInterval(tick, 10000);
}

function rStopStream() {
    if (rStreamTimer) { clearInterval(rStreamTimer); rStreamTimer = null; }
    const badge = document.getElementById('rStreamBadge');
    badge.className = 'rbadge rbadge-off'; badge.textContent = 'OFF';
    rApi('/api/status-rotator/stream-stop', {});
}
</script>


    <%- include('partials/super_button') %>
</body>

</html>
<%#- v2.2.2a %>
