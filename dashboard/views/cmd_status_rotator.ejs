<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Status Rotator - PRO+</title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
.container{width:95%;max-width:800px;margin:0 auto;padding:40px 20px 120px}
.page-header{text-align:center;margin-bottom:40px}
.page-header h1{font-size:2.5rem;background:linear-gradient(135deg,#fff,#a29bfe);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.section-card{background:#111116;border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:30px;margin-bottom:25px}
.section-title{font-size:1.1rem;color:#a29bfe;border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:10px;margin-bottom:20px}
.input-label{display:block;color:#ccc;font-size:.9rem;font-weight:600;margin-bottom:8px}
.input-field{width:100%;padding:12px;background:#050508;border:1px solid rgba(255,255,255,0.1);color:#fff;border-radius:10px;outline:none;font-family:'Outfit',sans-serif;transition:.3s}
.input-field:focus{border-color:#8a2be2}
.row{display:flex;gap:15px;align-items:flex-end;margin-bottom:15px}
.row .input-group{flex:1}
.input-group{margin-bottom:15px}
.btn{padding:12px 24px;border:none;border-radius:10px;font-weight:700;cursor:pointer;transition:.3s;font-family:'Outfit',sans-serif}
.btn-primary{background:linear-gradient(90deg,#8a2be2,#6c5ce7);color:#fff}
.btn-primary:hover{filter:brightness(1.15)}
.btn-danger{background:#e74c3c;color:#fff}
.btn-danger:hover{filter:brightness(1.15)}
.status-badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:700}
.badge-on{background:rgba(46,204,113,0.15);color:#2ecc71;border:1px solid rgba(46,204,113,0.3)}
.badge-off{background:rgba(255,255,255,0.05);color:#666;border:1px solid rgba(255,255,255,0.1)}
.tag-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.tag{background:#1a1a2e;border:1px solid rgba(138,43,226,0.3);border-radius:20px;padding:5px 12px;font-size:.82rem;color:#a29bfe;display:flex;align-items:center;gap:6px}
.tag .del{color:#ff6b6b;cursor:pointer}
.back-btn{position:absolute;top:30px;left:30px;color:rgba(255,255,255,0.5);text-decoration:none;font-size:1rem;display:flex;align-items:center;gap:5px;transition:.3s}
.back-btn:hover{color:#fff}
</style>
</head>
<body>
<a href="/commands" class="back-btn">← Back</a>
<div class="container">
  <div class="page-header">
    <h1>Status Rotator</h1>
    <p style="color:#888">Auto-rotate custom statuses and emojis on a timer.</p>
  </div>

  <!-- Status Rotation -->
  <div class="section-card">
    <div class="section-title">🔁 Status Rotation <span id="statusBadge" class="status-badge badge-off">OFF</span></div>
    <div class="input-group">
      <label class="input-label">Statuses (comma separated)</label>
      <input type="text" id="statusList" class="input-field" placeholder="Playing games, Watching anime, Coding...">
    </div>
    <div class="row">
      <div class="input-group">
        <label class="input-label">Interval (seconds)</label>
        <input type="number" id="statusInterval" class="input-field" value="8" min="3">
      </div>
      <button class="btn btn-primary" onclick="startStatus()">Start</button>
      <button class="btn btn-danger" onclick="stopStatus()">Stop</button>
    </div>
    <div id="statusTags" class="tag-list"></div>
  </div>

  <!-- Emoji Rotation -->
  <div class="section-card">
    <div class="section-title">😀 Emoji Rotation <span id="emojiBadge" class="status-badge badge-off">OFF</span></div>
    <div class="input-group">
      <label class="input-label">Emojis (comma separated)</label>
      <input type="text" id="emojiList" class="input-field" placeholder="😎, 🔥, 💀, 🎮">
    </div>
    <div class="row">
      <div class="input-group">
        <label class="input-label">Interval (seconds)</label>
        <input type="number" id="emojiInterval" class="input-field" value="8" min="3">
      </div>
      <button class="btn btn-primary" onclick="startEmoji()">Start</button>
      <button class="btn btn-danger" onclick="stopEmoji()">Stop</button>
    </div>
    <div id="emojiTags" class="tag-list"></div>
  </div>

  <!-- Stream Status -->
  <div class="section-card">
    <div class="section-title">📡 Stream Status Rotation <span id="streamBadge" class="status-badge badge-off">OFF</span></div>
    <div class="input-group">
      <label class="input-label">Stream names (comma separated)</label>
      <input type="text" id="streamList" class="input-field" placeholder="Playing Valorant, Grinding ranked...">
    </div>
    <div class="row">
      <button class="btn btn-primary" onclick="startStream()">Start</button>
      <button class="btn btn-danger" onclick="stopStream()">Stop</button>
    </div>
  </div>

  <!-- Online Status -->
  <div class="section-card">
    <div class="section-title">🟢 Online Status</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <button class="btn btn-primary" onclick="setStatus('online')">🟢 Online</button>
      <button class="btn btn-primary" onclick="setStatus('idle')">🌙 Idle</button>
      <button class="btn btn-primary" onclick="setStatus('dnd')">⛔ DND</button>
      <button class="btn btn-primary" onclick="setStatus('invisible')">👻 Invisible</button>
    </div>
  </div>
</div>

<%- include('partials/super_button') %>

<script>
let statusTimer = null, emojiTimer = null, streamTimer = null;

async function api(path, body) {
  const r = await fetch(path, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
  return r.json();
}

function renderTags(containerId, items) {
  const c = document.getElementById(containerId);
  c.innerHTML = items.map(t => `<div class="tag">${t}</div>`).join('');
}

async function startStatus() {
  const list = document.getElementById('statusList').value.split(',').map(s=>s.trim()).filter(Boolean);
  const interval = parseInt(document.getElementById('statusInterval').value) || 8;
  if (!list.length) return alert('Enter at least one status.');
  if (statusTimer) clearInterval(statusTimer);
  renderTags('statusTags', list);
  document.getElementById('statusBadge').className = 'status-badge badge-on'; document.getElementById('statusBadge').textContent = 'ON';
  let idx = 0;
  const tick = () => api('/api/status-rotator/set', { text: list[idx % list.length] }).then(() => idx++);
  await tick();
  statusTimer = setInterval(tick, interval * 1000);
}

function stopStatus() {
  if (statusTimer) { clearInterval(statusTimer); statusTimer = null; }
  document.getElementById('statusBadge').className = 'status-badge badge-off'; document.getElementById('statusBadge').textContent = 'OFF';
  api('/api/status-rotator/set', { text: '' });
}

async function startEmoji() {
  const list = document.getElementById('emojiList').value.split(',').map(s=>s.trim()).filter(Boolean);
  const interval = parseInt(document.getElementById('emojiInterval').value) || 8;
  if (!list.length) return alert('Enter at least one emoji.');
  if (emojiTimer) clearInterval(emojiTimer);
  renderTags('emojiTags', list);
  document.getElementById('emojiBadge').className = 'status-badge badge-on'; document.getElementById('emojiBadge').textContent = 'ON';
  let idx = 0;
  const tick = () => api('/api/status-rotator/emoji', { emoji: list[idx % list.length] }).then(() => idx++);
  await tick();
  emojiTimer = setInterval(tick, interval * 1000);
}

function stopEmoji() {
  if (emojiTimer) { clearInterval(emojiTimer); emojiTimer = null; }
  document.getElementById('emojiBadge').className = 'status-badge badge-off'; document.getElementById('emojiBadge').textContent = 'OFF';
}

async function startStream() {
  const list = document.getElementById('streamList').value.split(',').map(s=>s.trim()).filter(Boolean);
  if (!list.length) return alert('Enter at least one stream name.');
  if (streamTimer) clearInterval(streamTimer);
  document.getElementById('streamBadge').className = 'status-badge badge-on'; document.getElementById('streamBadge').textContent = 'ON';
  let idx = 0;
  const tick = () => api('/api/status-rotator/stream', { name: list[idx % list.length] }).then(() => idx++);
  await tick();
  streamTimer = setInterval(tick, 10000);
}

function stopStream() {
  if (streamTimer) { clearInterval(streamTimer); streamTimer = null; }
  document.getElementById('streamBadge').className = 'status-badge badge-off'; document.getElementById('streamBadge').textContent = 'OFF';
  api('/api/status-rotator/stream-stop', {});
}

function setStatus(s) { api('/api/status-rotator/online-status', { status: s }); }
</script>
</body>
</html>
