            // --- Custom File Upload ---
            let selectedFile = null;
            let uploadedFileUrl = null;   // Set after a successful upload
            let uploadedFileName = null;
            let selectedFileMode = 'manual';  // 'manual' or 'repeat'
            let isPaused = false;

            function openFileModal() {
                document.getElementById('fileModal').style.display = 'flex';
                // Reset state
                selectedFile = null;
                uploadedFileUrl = null;
                uploadedFileName = null;
                selectedFileMode = 'manual';
                document.getElementById('fileInput').value = '';
                document.getElementById('fileLabelText').innerText = 'Click to choose a file';
                document.getElementById('fileStatus').style.display = 'none';
                document.getElementById('fileProgressBarContainer').style.display = 'none';
                document.getElementById('fileProgressBar').style.width = '0%';
                document.getElementById('fileModeSection').classList.remove('visible');

                // Reset mode buttons
                document.getElementById('modeManualBtn').classList.add('active');
                document.getElementById('modeManualBtn').classList.remove('repeat-mode');
                document.getElementById('modeRepeatBtn').classList.remove('active', 'repeat-mode');

                const uploadBtn = document.getElementById('uploadBtn');
                uploadBtn.disabled = false;
                uploadBtn.style.opacity = '1';
                uploadBtn.style.cursor = 'pointer';
                uploadBtn.innerHTML = '<i class="fas fa-upload" style="margin-right: 6px;"></i> Upload';
            }

            function closeFileModal() {
                document.getElementById('fileModal').style.display = 'none';
            }

            function onFileSelected() {
                const input = document.getElementById('fileInput');
                if (!input.files || !input.files[0]) return;
                const file = input.files[0];

                // Validate type
                const validExts = ['mp3', 'mp4', 'm4a', 'wav', 'ogg', 'flac', 'aac', 'mkv', 'webm', 'mov', 'avi'];
                const ext = file.name.split('.').pop().toLowerCase();
                const isAudio = file.type.startsWith('audio/');
                const isVideo = file.type.startsWith('video/');
                if (!validExts.includes(ext) && !isAudio && !isVideo) {
                    alert('Please select an audio or video file (MP3, MP4, etc.)');
                    input.value = '';
                    return;
                }

                // Validate size (200MB max for catbox.moe)
                const maxSize = 200 * 1024 * 1024;
                if (file.size > maxSize) {
                    alert(`File too large! Max is 200MB. Your file is ${(file.size / 1024 / 1024).toFixed(1)}MB`);
                    input.value = '';
                    return;
                }

                selectedFile = file;
                const sizeMB = (file.size / 1024 / 1024).toFixed(2);
                document.getElementById('fileLabelText').innerHTML = `<i class="fas fa-check-circle" style="color: #2ecc71; margin-right: 6px;"></i><b>${file.name}</b><br><span style="color:#888; font-size:0.85rem;">${sizeMB} MB</span>`;
                
                const status = document.getElementById('fileStatus');
                status.style.display = 'block';
                status.style.color = '#aaa';
                status.innerText = 'Ready to upload. Click "Upload" to host the file. Playback will not start automatically.';

                const uploadBtn = document.getElementById('uploadBtn');
                uploadBtn.disabled = false;
                uploadBtn.style.opacity = '1';
                uploadBtn.style.cursor = 'pointer';

                // Hide mode section until upload completes
                document.getElementById('fileModeSection').classList.remove('visible');
                uploadedFileUrl = null;
            }

            // Upload only — does NOT auto-play. After success, shows mode selector + Play button.
            async function uploadFile() {
                if (!selectedFile) return alert('Please select a file first');
                if (!currentGuildId) {
                    alert('Error: No active guild. Join a voice channel first.');
                    return;
                }

                const uploadBtn = document.getElementById('uploadBtn');
                const originalText = uploadBtn.innerHTML;
                uploadBtn.disabled = true;
                uploadBtn.style.opacity = '0.7';
                uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 6px;"></i> Uploading...';

                const status = document.getElementById('fileStatus');
                const progressBarContainer = document.getElementById('fileProgressBarContainer');
                const progressBar = document.getElementById('fileProgressBar');
                progressBarContainer.style.display = 'block';
                progressBar.style.width = '0%';
                progressBar.style.background = 'linear-gradient(90deg, #8a2be2, #ff6b6b)';
                status.style.color = '#8a2be2';
                status.innerText = 'Uploading file to public host...';

                try {
                    // Use XMLHttpRequest for progress events
                    const fileUrl = await new Promise((resolve, reject) => {
                        const xhr = new XMLHttpRequest();
                        xhr.open('POST', '/api/voice/upload');
                        xhr.setRequestHeader('X-Filename', encodeURIComponent(selectedFile.name));
                        xhr.setRequestHeader('Content-Type', selectedFile.type || 'application/octet-stream');

                        xhr.upload.addEventListener('progress', (e) => {
                            if (e.lengthComputable) {
                                const pct = Math.round((e.loaded / e.total) * 100);
                                progressBar.style.width = pct + '%';
                                status.innerText = `Uploading... ${pct}%`;
                            }
                        });

                        xhr.addEventListener('load', () => {
                            try {
                                const data = JSON.parse(xhr.responseText);
                                if (data.success) {
                                    resolve(data.url);
                                } else {
                                    reject(new Error(data.message || 'Upload failed'));
                                }
                            } catch (e) {
                                reject(new Error('Invalid server response'));
                            }
                        });

                        xhr.addEventListener('error', () => reject(new Error('Network error during upload')));
                        xhr.addEventListener('timeout', () => reject(new Error('Upload timed out')));
                        xhr.timeout = 600000; // 10 minutes max
                        xhr.send(selectedFile);
                    });

                    uploadedFileUrl = fileUrl;
                    uploadedFileName = selectedFile.name;

                    progressBar.style.width = '100%';
                    progressBar.style.background = '#2ecc71';
                    status.style.color = '#2ecc71';
                    status.innerText = '✓ File uploaded! Choose a mode below, then click "Play Now".';

                    uploadBtn.innerHTML = '<i class="fas fa-check" style="margin-right: 6px;"></i> Uploaded';
                    uploadBtn.style.opacity = '0.6';
                    uploadBtn.style.cursor = 'default';

                    // Show the mode selector + Play button (NO auto-play)
                    document.getElementById('fileModeSection').classList.add('visible');

                } catch (e) {
                    console.error('Upload error:', e);
                    status.style.color = '#ff4757';
                    status.innerText = '✗ Error: ' + e.message;
                    progressBar.style.background = '#ff4757';
                    uploadBtn.innerHTML = originalText;
                    uploadBtn.disabled = false;
                    uploadBtn.style.opacity = '1';
                    uploadBtn.style.cursor = 'pointer';
                }
            }

            // Set the file playback mode (Manual or Repeat)
            function setFileMode(mode) {
                if (!['manual', 'repeat'].includes(mode)) return;
                selectedFileMode = mode;
                const manualBtn = document.getElementById('modeManualBtn');
                const repeatBtn = document.getElementById('modeRepeatBtn');
                if (mode === 'manual') {
                    manualBtn.classList.add('active');
                    manualBtn.classList.remove('repeat-mode');
                    repeatBtn.classList.remove('active', 'repeat-mode');
                } else {
                    repeatBtn.classList.add('active', 'repeat-mode');
                    manualBtn.classList.remove('active');
                }
            }

            // Play the uploaded file using the selected mode (Manual or Repeat).
            // This is the explicit user action — upload alone never starts playback.
            async function playUploadedFile() {
                if (!uploadedFileUrl) return alert('Upload a file first');
                if (!currentGuildId) return alert('Error: No active guild');

                const playBtn = document.getElementById('playUploadedBtn');
                const originalText = playBtn.innerHTML;
                playBtn.disabled = true;
                playBtn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 6px;"></i> Starting...';

                try {
                    // Start playing the file
                    const playRes = await fetch('/api/music/play', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ guildId: currentGuildId, query: uploadedFileUrl })
                    });
                    const playData = await playRes.json();

                    if (!playData.success) {
                        throw new Error(playData.message || playData.reason || 'Failed to play');
                    }

                    // Apply the chosen repeat mode AFTER playback starts
                    if (selectedFileMode === 'repeat') {
                        // Set infinite loop
                        await fetch('/api/music/loop', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ guildId: currentGuildId, mode: 'loop', count: 1 })
                        });
                        showLoopMessage('Repeat mode: LOOP (file will auto-replay forever)');
                    } else {
                        // Manual mode: ensure repeat is OFF so playback ends naturally
                        await fetch('/api/music/loop', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ guildId: currentGuildId, mode: 'once', count: 1 })
                        });
                        showLoopMessage('Manual mode: use ▶/⏸ to control. File will not auto-replay.');
                    }

                    playBtn.innerHTML = '<i class="fas fa-check" style="margin-right: 6px;"></i> Playing!';
                    setTimeout(() => {
                        closeFileModal();
                        playBtn.innerHTML = originalText;
                        playBtn.disabled = false;
                    }, 1500);
                    updateState();
                } catch (e) {
                    console.error('Play uploaded file error:', e);
                    alert('Error: ' + e.message);
                    playBtn.innerHTML = originalText;
                    playBtn.disabled = false;
                }
            }

