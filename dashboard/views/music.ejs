                    if (count > 100) count = 100;
                    input.value = count;
                }

                try {
                    const res = await fetch('/api/music/loop', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            guildId: currentGuildId,
                            mode: mode,
                            count: count
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        let label = 'Once';
                        if (mode === 'loop') label = 'Loop (infinite)';
                        else if (mode === 'queue') label = 'Queue loop';
                        else if (mode === 'repeatN') label = `Repeat ${count} times`;
                        showLoopMessage(label);
                        document.getElementById('repeatModal').style.display = 'none';
                    } else {
                        alert('Error: ' + (data.message || 'Failed'));
