                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ guildId: currentGuildId, soundId })
                    });
                    const data = await res.json();
                    status.style.color = data.success ? '#2ecc71' : '#ff4757';
                    status.innerText = data.success ? '\u2713 Playing!' : 'Error: ' + data.message;
                } catch (e) {
                    status.style.color = '#ff4757';
                    status.innerText = 'Network error';
                }
                setTimeout(() => { status.innerText = ''; }, 3000);
            }

            // ── Voice Recorder ───────────────────────────────────────────────
            let recPolling = null;
            async function recStart() {
                const fmt = document.getElementById('recFormatSelect').value;
                const startBtn = document.getElementById('recStartBtn');
                const stopBtn = document.getElementById('recStopBtn');
                const status = document.getElementById('recStatus');
                startBtn.disabled = true; startBtn.style.opacity = '0.5';
                try {
                    const r = await fetch('/api/music/record/start', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({format:fmt}) });
                    const d = await r.json();
                    if (d.success) {
                        status.style.color = '#e74c3c'; status.textContent = '⏺ Recording... click Stop when done.';
                        stopBtn.disabled = false; stopBtn.style.cursor = 'pointer'; stopBtn.style.color = '#fff';
                        stopBtn.style.background = 'rgba(231,76,60,0.2)';
                    } else {
                        status.style.color = '#ff4757'; status.textContent = 'Error: ' + d.message;
                        startBtn.disabled = false; startBtn.style.opacity = '1';
                    }
                } catch(e) {
                    status.style.color = '#ff4757'; status.textContent = 'Network error';
                    startBtn.disabled = false; startBtn.style.opacity = '1';
                }
            }
            async function recStop() {
                const startBtn = document.getElementById('recStartBtn');
                const stopBtn = document.getElementById('recStopBtn');
                const status = document.getElementById('recStatus');
                stopBtn.disabled = true; stopBtn.style.cursor = 'not-allowed'; stopBtn.style.color = '#666';
                try {
                    const r = await fetch('/api/music/record/stop', { method:'POST' });
                    const d = await r.json();
                    if (d.success) {
                        status.style.color = '#2ecc71'; status.textContent = '✓ Saved: ' + (d.filename || 'recording');
                        recLoadFiles();
                    } else {
                        status.style.color = '#ff4757'; status.textContent = 'Error: ' + d.message;
                    }
                } catch(e) {
                    status.style.color = '#ff4757'; status.textContent = 'Network error';
                }
                startBtn.disabled = false; startBtn.style.opacity = '1';
            }
            async function recLoadFiles() {
                try {
                    const r = await fetch('/api/music/record/list');
                    const d = await r.json();
                    const list = document.getElementById('recFilesList');
                    if (!d.files || !d.files.length) { list.innerHTML = ''; return; }
                    list.innerHTML = d.files.map(f => `
                        <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:8px 12px;gap:8px;flex-wrap:wrap;">
                            <span style="font-size:0.82rem;color:#ccc;font-family:monospace;">${f.name}</span>
                            <span style="font-size:0.74rem;color:#555;">${f.size}</span>
                            <a href="/api/music/record/download/${encodeURIComponent(f.name)}" download style="padding:4px 12px;border-radius:8px;border:1px solid rgba(138,43,226,0.3);background:rgba(138,43,226,0.1);color:#a29bfe;font-size:0.78rem;font-weight:700;text-decoration:none;">⬇ Download</a>
                        </div>`).join('');
                } catch(e) {}
            }
            recLoadFiles();

            setInterval(updateState, 3000);
            updateState();
        </script>
</body>

</html>
