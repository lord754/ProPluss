            let loadedSoundboardGuild = null;
            async function loadSoundboard(guildId) {
                if (loadedSoundboardGuild === guildId) return;
                loadedSoundboardGuild = guildId;
                const container = document.getElementById('soundboardList');
                container.innerHTML = '<span style="color:#444; font-size:0.85rem;">Loading...</span>';
                try {
                    const res = await fetch(`/api/music/soundboard/${guildId}`);
                    const data = await res.json();
                    if (!data.sounds || data.sounds.length === 0) {
                        container.innerHTML = '<span style="color:#444; font-size:0.85rem;">No sounds found in this server.</span>';
                        return;
                    }
                    container.innerHTML = '';
                    data.sounds.forEach(s => {
                        const btn = document.createElement('button');
                        btn.style.cssText = 'padding: 7px 14px; border-radius: 20px; border: 1px solid rgba(138,43,226,0.3); background: rgba(138,43,226,0.1); color: #a29bfe; cursor: pointer; font-size: 0.82rem; font-weight: 600; transition: 0.2s;';
                        btn.innerHTML = (s.emoji ? s.emoji + ' ' : '\uD83D\uDD0A ') + s.name;
                        btn.onmouseover = () => { btn.style.background = 'rgba(138,43,226,0.3)'; btn.style.color = '#fff'; };
                        btn.onmouseout = () => { btn.style.background = 'rgba(138,43,226,0.1)'; btn.style.color = '#a29bfe'; };
                        btn.onclick = () => playSound(s.id);
                        container.appendChild(btn);
                    });
                } catch (e) {
                    container.innerHTML = '<span style="color:#ff4757; font-size:0.85rem;">Failed to load sounds.</span>';
                }
            }

            async function playSound(soundId) {
