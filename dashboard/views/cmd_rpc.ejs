<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RPC Configuration - PRO+</title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
.rpc-container{width:95%;max-width:900px;margin:0 auto;padding:40px 20px 120px}
.rpc-header{text-align:center;margin-bottom:40px}
.rpc-header h1{font-size:2.5rem;margin-bottom:10px;background:linear-gradient(135deg,#fff,#a29bfe);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.section-card{background:#111116;border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:30px;margin-bottom:25px;box-shadow:0 10px 30px rgba(0,0,0,0.3)}
.section-title{font-size:1.2rem;margin-bottom:20px;color:#a29bfe;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:10px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.full-width{grid-column:1/-1}
.input-group{margin-bottom:15px}
.input-label{display:block;margin-bottom:8px;color:#ccc;font-size:.9rem;font-weight:600}
.input-field{width:100%;padding:12px;background:#050508;border:1px solid rgba(255,255,255,0.1);color:#fff;border-radius:10px;outline:none;transition:.3s;font-family:'Outfit',sans-serif}
.input-field:focus{border-color:#8a2be2;box-shadow:0 0 15px rgba(138,43,226,0.2)}
select.input-field{appearance:none;cursor:pointer}
.btn-save{width:100%;padding:18px;font-size:1.2rem;font-weight:700;background:linear-gradient(90deg,#8a2be2,#6c5ce7);border:none;border-radius:12px;color:#fff;cursor:pointer;transition:.3s;box-shadow:0 5px 20px rgba(138,43,226,0.3)}
.btn-save:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(138,43,226,0.5)}
.status-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.switch{position:relative;display:inline-block;width:60px;height:30px}
.switch input{opacity:0;width:0;height:0}
.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background-color:#333;transition:.4s;border-radius:34px}
.slider:before{position:absolute;content:"";height:22px;width:22px;left:4px;bottom:4px;background-color:white;transition:.4s;border-radius:50%}
input:checked+.slider{background-color:#9d14ff}
input:checked+.slider:before{transform:translateX(30px)}
.back-btn{position:absolute;top:30px;left:30px;z-index:1000;color:rgba(255,255,255,0.5);text-decoration:none;font-size:1rem;display:flex;align-items:center;gap:5px;transition:.3s}
.back-btn:hover{color:#fff}
@keyframes neonPulse{0%{box-shadow:0 0 5px rgba(138,43,226,0.5);border-color:rgba(138,43,226,0.5)}50%{box-shadow:0 0 20px rgba(138,43,226,1);border-color:rgba(184,125,248,1)}100%{box-shadow:0 0 5px rgba(138,43,226,0.5);border-color:rgba(138,43,226,0.5)}}
.neon-card{border:2px solid #8a2be2!important;animation:neonPulse 2s infinite alternate}
@keyframes neonPulseRed{0%{box-shadow:0 0 5px rgba(255,60,60,0.5);border-color:rgba(255,60,60,0.5)}50%{box-shadow:0 0 20px rgba(255,60,60,1);border-color:rgba(255,100,100,1)}100%{box-shadow:0 0 5px rgba(255,60,60,0.5);border-color:rgba(255,60,60,0.5)}}
.neon-card-red{border:2px solid #ff3c3c!important;animation:neonPulseRed 2s infinite alternate}

/* Picker */
.picker-search{width:100%;padding:10px 14px;background:#0a0a0f;border:1px solid rgba(255,255,255,0.12);color:#fff;border-radius:10px;outline:none;margin-bottom:12px;font-family:'Outfit',sans-serif;font-size:.95rem}
.picker-search:focus{border-color:#8a2be2}
.picker-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;max-height:320px;overflow-y:auto;padding-right:4px}
.picker-grid::-webkit-scrollbar{width:6px}
.picker-grid::-webkit-scrollbar-track{background:#111}
.picker-grid::-webkit-scrollbar-thumb{background:#333;border-radius:3px}
.picker-item{background:#0a0a0f;border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:12px 10px;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;transition:.2s;text-align:center}
.picker-item:hover{border-color:rgba(138,43,226,0.5);background:rgba(138,43,226,0.06)}
.picker-item.active{border-color:#8a2be2;background:rgba(138,43,226,0.15);box-shadow:0 0 12px rgba(138,43,226,0.3)}
.picker-item img{width:40px;height:40px;border-radius:8px;object-fit:cover;background:#1a1a2e}
.picker-item span{font-size:.75rem;color:#ccc;line-height:1.2;word-break:break-word}
.picker-item.active span{color:#fff}

/* Presets */
.preset-bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:15px}
.preset-chip{background:#1a1a2e;border:1px solid rgba(138,43,226,0.3);border-radius:20px;padding:6px 14px;font-size:.82rem;color:#a29bfe;cursor:pointer;display:flex;align-items:center;gap:6px;transition:.2s}
.preset-chip:hover{border-color:#8a2be2;background:rgba(138,43,226,0.1)}
.preset-chip .del{color:#ff6b6b;font-size:.9rem;margin-left:2px}
.preset-chip .del:hover{color:#ff3c3c}
.preset-input-row{display:flex;gap:10px}
.preset-input-row input{flex:1;padding:10px 14px;background:#0a0a0f;border:1px solid rgba(255,255,255,0.1);color:#fff;border-radius:10px;outline:none;font-family:'Outfit',sans-serif}
.preset-input-row input:focus{border-color:#8a2be2}
.btn-sm{padding:10px 18px;background:linear-gradient(90deg,#8a2be2,#6c5ce7);border:none;border-radius:10px;color:#fff;font-weight:600;cursor:pointer;font-size:.9rem;white-space:nowrap}
.btn-sm:hover{filter:brightness(1.15)}

@media(max-width:768px){.form-grid,.picker-grid{grid-template-columns:1fr}.rpc-container{padding:80px 15px 120px}.back-btn{top:20px;left:20px}}
</style>
</head>
<body>
<a href="/commands" class="back-btn">← Back</a>
<div class="rpc-container">
  <div class="rpc-header">
    <h1>Rich Presence</h1>
    <p>Customize your activity status visible to others.</p>
  </div>

  <!-- PRESETS -->
  <div class="section-card">
    <div class="section-title">⚡ Presets (max 100)</div>
    <div class="preset-bar" id="presetBar"></div>
    <div class="preset-input-row">
      <input type="text" id="presetName" placeholder="Preset name..." maxlength="40">
      <button class="btn-sm" onclick="savePreset()">Save Current</button>
    </div>
  </div>

  <form id="rpcForm" onsubmit="saveRpc(event)">
    <div class="section-card">
      <div class="status-row">
        <span style="font-size:1.2rem;font-weight:600">Enable RPC</span>
        <label class="switch"><input type="checkbox" id="enabled" onchange="saveRpc(null,true)"><span class="slider"></span></label>
      </div>
      <div class="form-grid">
        <div class="input-group">
          <label class="input-label">Activity Type</label>
          <select id="type" class="input-field">
            <option value="PLAYING">Playing</option>
            <option value="STREAMING">Streaming</option>
            <option value="LISTENING">Listening</option>
            <option value="WATCHING">Watching</option>
            <option value="COMPETING">Competing</option>
          </select>
        </div>
        <div class="input-group">
          <label class="input-label">Name (Top Line)</label>
          <input type="text" id="name" class="input-field" placeholder="e.g. PRO+ Bot">
        </div>
        <div class="input-group">
          <label class="input-label">Custom Application ID <span style="color:#666;font-size:0.8rem">(optional — overrides game selection)</span></label>
          <input type="text" id="applicationId" class="input-field" placeholder="e.g. 1402418440685486130" maxlength="25" pattern="[0-9]*">
          <div style="font-size:0.75rem;color:#555;margin-top:4px">Leave blank to use game spoof app ID. Enter your own Discord Application ID to use a custom rich presence.</div>
        </div>
    </div>

    <div class="section-card">
      <div class="section-title">Details &amp; State</div>
      <div class="form-grid">
        <div class="input-group full-width">
          <label class="input-label">Details (Second Line)</label>
          <input type="text" id="details" class="input-field" placeholder="e.g. Preparing for battle">
        </div>
        <div class="input-group full-width">
          <label class="input-label">State (Third Line)</label>
          <input type="text" id="state" class="input-field" placeholder="e.g. Level 99">
        </div>
      </div>

      <div class="section-card">
        <div class="section-title">Time Details &amp; Progress Bar</div>
        <div class="status-row" style="margin-bottom:15px">
          <span style="font-size:1rem;color:#ccc">Enable Progress Bar (Spotify Style)</span>
          <label class="switch"><input type="checkbox" id="enableProgressBar" onchange="toggleProgressBarOptions()"><span class="slider"></span></label>
        </div>
        <div class="form-grid" id="normalTimeGroup">
          <div class="input-group">
            <label class="input-label" id="lblStartTime">Start Time From Now</label>
            <input type="number" id="timeVal" class="input-field" placeholder="e.g. 5" min="0">
          </div>
          <div class="input-group">
            <label class="input-label" id="lblStartUnit">Unit</label>
            <select id="timeUnit" class="input-field">
              <option value="minute">Minutes</option>
              <option value="hour">Hours</option>
              <option value="day">Days</option>
            </select>
          </div>
        </div>
        <div class="form-grid" id="endTimeGroup" style="display:none;margin-top:15px">
          <div class="input-group">
            <label class="input-label">Total Duration (End Time)</label>
            <input type="number" id="endVal" class="input-field" placeholder="e.g. 5" min="0">
          </div>
          <div class="input-group">
            <label class="input-label">Unit</label>
            <select id="endUnit" class="input-field">
              <option value="minute">Minutes</option>
              <option value="hour">Hours</option>
              <option value="day">Days</option>
            </select>
          </div>
        </div>
      </div>

      <!-- GAME SPOOFING -->
      <div class="section-card neon-card-red">
        <div class="section-title" style="color:#ff6b81;border-color:rgba(255,107,129,0.2)">Game Spoofing</div>
        <div class="status-row" style="margin-bottom:5px">
          <span style="font-size:1rem;color:#ccc">Enable Game Spoofing</span>
          <label class="switch"><input type="checkbox" id="gameSpoofing" onchange="toggleGameSpoofing(true)"><span class="slider"></span></label>
        </div>
        <p style="color:#666;font-size:.85rem;margin-bottom:15px">Overrides ALL other RPC settings and shows a real game presence.</p>
        <input type="hidden" id="selectedGame" value="none">
        <div id="gameSpoofOptionContainer" style="display:none;margin-top:12px">
          <input type="text" class="picker-search" id="gameSearch" placeholder="Search games..." oninput="filterPicker()">
          <div class="picker-grid" id="gamePickerGrid"></div>
        </div>
      </div>

      <div class="section-card">
        <div class="section-title">Images (Assets)</div>
        <p style="color:#666;font-size:.82rem;margin-bottom:15px">Discord CDN URLs work natively. External URLs (imgur, etc.) are auto-proxied.</p>
        <div class="form-grid">
          <div class="input-group">
            <label class="input-label">Large Image URL</label>
            <input type="text" id="largeImage" class="input-field" placeholder="https://cdn.discordapp.com/... or any URL">
          </div>
          <div class="input-group">
            <label class="input-label">Large Image Tooltip</label>
            <input type="text" id="largeText" class="input-field" placeholder="Text when hovering image">
          </div>
          <div class="input-group">
            <label class="input-label">Small Image URL</label>
            <input type="text" id="smallImage" class="input-field" placeholder="https://cdn.discordapp.com/... or any URL">
          </div>
          <div class="input-group">
            <label class="input-label">Small Image Tooltip</label>
            <input type="text" id="smallText" class="input-field" placeholder="Text when hovering small image">
          </div>
        </div>
      </div>

      <div class="section-card">
        <div class="section-title">Interactive Buttons</div>
        <div class="form-grid">
          <div class="input-group">
            <label class="input-label">Button 1 Label</label>
            <input type="text" id="button1Text" class="input-field" placeholder="Visit Website">
          </div>
          <div class="input-group">
            <label class="input-label">Button 1 URL</label>
            <input type="text" id="button1Url" class="input-field" placeholder="https://...">
          </div>
          <div class="input-group">
            <label class="input-label">Button 2 Label</label>
            <input type="text" id="button2Text" class="input-field" placeholder="Join Server">
          </div>
          <div class="input-group">
            <label class="input-label">Button 2 URL</label>
            <input type="text" id="button2Url" class="input-field" placeholder="https://...">
          </div>
        </div>
        <p style="color:#666;font-size:.8rem;margin-top:-10px;font-style:italic">Note: Discord prevents you from clicking your own RPC buttons.</p>
      </div>

      <button type="submit" class="btn-save" id="saveBtn">Save Configuration</button>
  </form>
</div>

<%- include('partials/super_button') %>

<script>
let ALL_GAMES = [];

async function loadCatalog() {
  const r = await fetch('/api/rpc/catalog');
  const d = await r.json();
  ALL_GAMES = d.games;
  renderPicker('game', ALL_GAMES, document.getElementById('selectedGame').value);
}

function renderPicker(type, list, selected) {
  const grid = document.getElementById(type === 'game' ? 'gamePickerGrid' : 'appPickerGrid');
  const hiddenId = type === 'game' ? 'selectedGame' : 'spoofType';
  grid.innerHTML = '';
  list.forEach(item => {
    const div = document.createElement('div');
    div.className = 'picker-item' + (item.id === selected ? ' active' : '');
    div.dataset.id = item.id;
    const imgSrc = item.logo || 'https://cdn.discordapp.com/embed/avatars/0.png';
    div.innerHTML = `<img src="${imgSrc}" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'" loading="lazy"><span>${item.name}</span>`;
    div.onclick = () => {
      document.getElementById(hiddenId).value = item.id;
      grid.querySelectorAll('.picker-item').forEach(x => x.classList.remove('active'));
      div.classList.add('active');
      saveRpc(null, true);
    };
    grid.appendChild(div);
  });
}

function filterPicker() {
  const q = document.getElementById('gameSearch').value.toLowerCase();
  const list = ALL_GAMES.filter(x => x.name.toLowerCase().includes(q));
  renderPicker('game', list, document.getElementById('selectedGame').value);
}

// ---- PRESETS ----
async function loadPresets() {
  const list = await fetch('/api/rpc/presets').then(r => r.json());
  const bar = document.getElementById('presetBar');
  bar.innerHTML = list.length === 0 ? '<span style="color:#555;font-size:.85rem">No presets saved yet.</span>' : '';
  list.forEach(p => {
    const chip = document.createElement('div');
    chip.className = 'preset-chip';
    chip.innerHTML = `<span onclick="loadPreset('${p.name.replace(/'/g,"\\'")}')">📋 ${p.name}</span><span class="del" onclick="deletePreset('${p.name.replace(/'/g,"\\'")}')">✕</span>`;
    bar.appendChild(chip);
  });
}

async function savePreset() {
  const name = document.getElementById('presetName').value.trim();
  if (!name) return alert('Enter a preset name.');
  const config = collectFormData();
  const r = await fetch('/api/rpc/presets/save', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name, config }) }).then(x => x.json());
  if (!r.success) return alert(r.error || 'Failed');
  document.getElementById('presetName').value = '';
  loadPresets();
}

async function loadPreset(name) {
  const r = await fetch('/api/rpc/presets/load', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name }) }).then(x => x.json());
  if (!r.success) return alert('Preset not found');
  applyFormData(r.config);
  saveRpc(null, true);
}

async function deletePreset(name) {
  await fetch('/api/rpc/presets/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name }) });
  loadPresets();
}

// ---- FORM ----
function collectFormData() {
  return {
    enabled: document.getElementById('enabled').checked,
    type: document.getElementById('type').value,
    name: document.getElementById('name').value,
    applicationId: document.getElementById('applicationId').value.trim(),
    details: document.getElementById('details').value,
    state: document.getElementById('state').value,
    gameSpoofing: document.getElementById('gameSpoofing').checked,
    selectedGame: document.getElementById('selectedGame').value,
    enableProgressBar: document.getElementById('enableProgressBar').checked,
    startTimestamp: calculateMs('timeVal','timeUnit'),
    endTimestamp: calculateMs('endVal','endUnit'),
    largeImage: document.getElementById('largeImage').value,
    largeText: document.getElementById('largeText').value,
    smallImage: document.getElementById('smallImage').value,
    smallText: document.getElementById('smallText').value,
    button1Text: document.getElementById('button1Text').value,
    button1Url: document.getElementById('button1Url').value,
    button2Text: document.getElementById('button2Text').value,
    button2Url: document.getElementById('button2Url').value,
  };
}

function applyFormData(d) {
  document.getElementById('enabled').checked = d.enabled || false;
  document.getElementById('type').value = d.type || 'PLAYING';
  document.getElementById('name').value = d.name || '';
  document.getElementById('applicationId').value = d.applicationId || '';
  document.getElementById('details').value = d.details || '';
  document.getElementById('state').value = d.state || '';
  document.getElementById('gameSpoofing').checked = d.gameSpoofing || false;
  document.getElementById('selectedGame').value = d.selectedGame || 'none';
  document.getElementById('enableProgressBar').checked = d.enableProgressBar || false;
  document.getElementById('largeImage').value = d.largeImage || '';
  document.getElementById('largeText').value = d.largeText || '';
  document.getElementById('smallImage').value = d.smallImage || '';
  document.getElementById('smallText').value = d.smallText || '';
  document.getElementById('button1Text').value = d.button1Text || '';
  document.getElementById('button1Url').value = d.button1Url || '';
  document.getElementById('button2Text').value = d.button2Text || '';
  document.getElementById('button2Url').value = d.button2Url || '';
  reverseTime(d.startTimestamp, 'timeVal', 'timeUnit');
  reverseTime(d.endTimestamp, 'endVal', 'endUnit');
  toggleGameSpoofing(false); toggleProgressBarOptions(true);
  if (d.gameSpoofing) renderPicker('game', ALL_GAMES, d.selectedGame || 'none');
}

function reverseTime(ms, valId, unitId) {
  if (!ms || ms <= 0) { document.getElementById(valId).value = ''; return; }
  if (ms >= 86400000 && ms % 86400000 === 0) { document.getElementById(valId).value = ms/86400000; document.getElementById(unitId).value = 'day'; }
  else if (ms >= 3600000 && ms % 3600000 === 0) { document.getElementById(valId).value = ms/3600000; document.getElementById(unitId).value = 'hour'; }
  else { document.getElementById(valId).value = Math.floor(ms/60000); document.getElementById(unitId).value = 'minute'; }
}

window.onload = async () => {
  await loadCatalog();
  try {
    const data = await fetch('/api/rpc').then(r => r.json());
    applyFormData(data);
  } catch(e) { console.error(e); }
  loadPresets();
};

async function saveRpc(e, silent=false) {
  if (e) e.preventDefault();
  const btn = document.getElementById('saveBtn');
  if (!silent) { btn.innerText = 'Saving...'; btn.disabled = true; }
  try {
    const r = await fetch('/api/rpc', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(collectFormData()) }).then(x => x.json());
    if (!silent) {
      btn.innerText = r.success ? 'Saved Successfully!' : 'Failed';
      btn.style.background = r.success ? '#2ecc71' : '#e74c3c';
      setTimeout(() => { btn.innerText = 'Save Configuration'; btn.style.background = ''; btn.disabled = false; }, 2000);
    }
  } catch(e) { if (!silent) { btn.innerText = 'Save Configuration'; btn.disabled = false; } }
}

function calculateMs(valId, unitId) {
  const val = parseInt(document.getElementById(valId).value);
  const unit = document.getElementById(unitId).value;
  if (!val || val < 0) return 0;
  if (unit === 'minute') return val*60*1000;
  if (unit === 'hour') return val*3600*1000;
  if (unit === 'day') return val*86400*1000;
  return 0;
}

function toggleProgressBarOptions(isInit=false) {
  const on = document.getElementById('enableProgressBar').checked;
  document.getElementById('endTimeGroup').style.display = on ? 'grid' : 'none';
  document.getElementById('lblStartTime').innerText = on ? 'Time Passed Already (Position)' : 'Start Time From Now';
}

function toggleGameSpoofing(autoSave=false) {
  const on = document.getElementById('gameSpoofing').checked;
  const c = document.getElementById('gameSpoofOptionContainer');
  c.style.display = on ? 'block' : 'none';
  const fields = ['type','name','details','state','largeImage','largeText','smallImage','smallText','button1Text','button1Url','button2Text','button2Url'];
  fields.forEach(f => { const el = document.getElementById(f); if(el){el.disabled=on;el.style.opacity=on?'0.3':'1';} });
  if (on) renderPicker('game', ALL_GAMES, document.getElementById('selectedGame').value);
  if (autoSave) saveRpc(null, true);
}
</script>
</body>
</html>
