<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Extra Features — THE BIG 5 | PRO+</title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{min-height:100vh;background:#050508;color:#fff;font-family:'Outfit',sans-serif}
.container{width:95%;max-width:960px;margin:0 auto;padding:30px 20px 140px}
.back-btn{position:fixed;top:20px;left:20px;z-index:100;display:inline-flex;align-items:center;gap:8px;padding:9px 16px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:#aaa;text-decoration:none;font-size:.85rem;font-weight:600;transition:.2s}
.back-btn:hover{background:rgba(255,255,255,0.1);color:#fff}
.page-header{text-align:center;margin:60px 0 32px}
.page-header h1{font-size:2.2rem;font-weight:800;background:linear-gradient(135deg,#fff,#a29bfe);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.page-header p{color:#555;font-size:.9rem;margin-top:6px}
.section{background:#111116;border:1px solid rgba(255,255,255,0.07);border-radius:20px;padding:22px;margin-bottom:16px}
.section-title{font-size:.82rem;font-weight:800;color:#a29bfe;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:10px;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.row{display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,0.04);gap:10px;flex-wrap:wrap}
.row:last-child{border-bottom:none}
.row-info{flex:1;min-width:0}
.row-name{color:#fff;font-size:.9rem;font-weight:600}
.row-desc{color:#555;font-size:.76rem;margin-top:2px}
.row-cmd{font-family:monospace;font-size:.72rem;color:#6c5ce7;background:rgba(108,92,231,0.1);padding:2px 6px;border-radius:4px;margin-top:3px;display:inline-block}
.row-actions{display:flex;gap:7px;align-items:center;flex-shrink:0;flex-wrap:wrap}
/* Toggle */
.toggle{position:relative;width:44px;height:23px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.slider{position:absolute;inset:0;background:#1e1e2e;border:1px solid rgba(255,255,255,0.1);border-radius:23px;cursor:pointer;transition:.3s}
.slider:before{content:'';position:absolute;width:17px;height:17px;left:2px;top:2px;background:#555;border-radius:50%;transition:.3s}
input:checked+.slider{background:linear-gradient(90deg,#8a2be2,#6c5ce7);border-color:transparent}
input:checked+.slider:before{background:#fff;transform:translateX(21px)}
/* Inputs */
.inp{flex:1;min-width:100px;padding:8px 12px;background:#050508;border:1px solid rgba(255,255,255,0.08);color:#fff;border-radius:9px;outline:none;font-family:'Outfit',sans-serif;font-size:.85rem;transition:.2s}
.inp:focus{border-color:#8a2be2}
.inp::placeholder{color:#333}
/* Buttons */
.btn{padding:7px 14px;border:none;border-radius:9px;font-weight:700;cursor:pointer;font-size:.78rem;transition:.2s;font-family:'Outfit',sans-serif;white-space:nowrap}
.btn:disabled{opacity:.35;cursor:not-allowed}
.btn-p{background:linear-gradient(90deg,#8a2be2,#6c5ce7);color:#fff}
.btn-p:not(:disabled):hover{filter:brightness(1.15)}
.btn-d{background:rgba(231,76,60,0.1);color:#e74c3c;border:1px solid rgba(231,76,60,0.2)}
.btn-d:not(:disabled):hover{background:#e74c3c;color:#fff}
.btn-s{background:rgba(255,255,255,0.05);color:#aaa;border:1px solid rgba(255,255,255,0.08)}
.btn-s:not(:disabled):hover{background:rgba(255,255,255,0.1);color:#fff}
.btn-w{background:rgba(243,156,18,0.1);color:#f39c12;border:1px solid rgba(243,156,18,0.2)}
.btn-w:not(:disabled):hover{background:#f39c12;color:#fff}
.btn-g{background:rgba(46,204,113,0.1);color:#2ecc71;border:1px solid rgba(46,204,113,0.2)}
.btn-g:not(:disabled):hover{background:#2ecc71;color:#000}
/* Grid layouts */
.input-group{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.input-group .inp{min-width:140px}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
/* Result box */
.result-box{background:#050508;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:10px 14px;font-size:.8rem;color:#888;font-family:monospace;margin-top:10px;display:none;white-space:pre-wrap;word-break:break-all}
/* Toast */
.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:#1e1e2e;border:1px solid rgba(138,43,226,0.4);color:#fff;padding:12px 24px;border-radius:12px;font-size:.88rem;opacity:0;transition:.3s;pointer-events:none;z-index:9999;max-width:360px;text-align:center}
.toast.show{opacity:1}
/* Status dot */
.status-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dot-on{background:#2ecc71;box-shadow:0 0 5px rgba(46,204,113,0.6)}
.dot-off{background:#555}
/* Search */
.search-bar{width:100%;padding:11px 16px;background:#0d0d12;border:1px solid rgba(255,255,255,0.08);color:#fff;border-radius:12px;outline:none;font-family:'Outfit',sans-serif;font-size:.9rem;margin-bottom:20px;transition:.2s}
.search-bar:focus{border-color:#8a2be2}
.search-bar::placeholder{color:#333}
/* Category badge */
.cat-badge{font-size:.66rem;font-weight:800;padding:2px 7px;border-radius:8px;text-transform:uppercase;letter-spacing:.4px}
.cat-red{background:rgba(231,76,60,0.15);color:#e74c3c;border:1px solid rgba(231,76,60,0.25)}
.cat-purple{background:rgba(138,43,226,0.12);color:#c084fc;border:1px solid rgba(138,43,226,0.2)}
.cat-green{background:rgba(46,204,113,0.1);color:#2ecc71;border:1px solid rgba(46,204,113,0.2)}
.cat-blue{background:rgba(52,152,219,0.12);color:#3498db;border:1px solid rgba(52,152,219,0.2)}
.cat-orange{background:rgba(243,156,18,0.1);color:#f39c12;border:1px solid rgba(243,156,18,0.2)}
/* Section collapse */
.section-toggle{cursor:pointer;user-select:none}
.section-toggle:hover .section-title{color:#c084fc}
.section-body{transition:max-height .3s ease;overflow:hidden}
.chevron{font-size:.7rem;color:#555;margin-left:auto;transition:transform .2s}
.chevron.open{transform:rotate(180deg)}
@media(max-width:560px){.row{flex-direction:column;align-items:flex-start}.row-actions{width:100%}}
</style>
</head>
<body>
<a href="/commands" class="back-btn">← Back</a>
<div class="container">
  <div class="page-header">
    <h1>⚡ Extra Features</h1>
    <p>Full Big5 control panel — all 221+ commands accessible from dashboard</p>
  </div>

  <input type="text" class="search-bar" id="searchBar" placeholder="🔍 Search commands..." oninput="filterSections()">

  <!-- ── 1. AUTO FEATURES ── -->
  <div class="section searchable" data-keywords="agct anti gc silentantigc alw last word snipe stfu autodelete dreact autoreact autoflood arr auto reply mimic blackify autonick autobump triggertyping antiafk">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🛡️ Auto Features <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Anti-GC Trap <span class="status-dot dot-off" id="dot-agct"></span></div><div class="row-desc">Auto-leave + block when added to group chat</div><span class="row-cmd">.agct on/off</span></div>
        <label class="toggle"><input type="checkbox" id="agct" onchange="toggleFeature('agct',this.checked)"><span class="slider"></span></label>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Silent Anti-GC <span class="status-dot dot-off" id="dot-silentantigc"></span></div><div class="row-desc">Silently leave group chats without blocking</div><span class="row-cmd">.silentantigc on/off</span></div>
        <label class="toggle"><input type="checkbox" id="silentantigc" onchange="toggleFeature('silentantigc',this.checked)"><span class="slider"></span></label>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Last Word (ALW) <span class="status-dot dot-off" id="dot-alw"></span></div><div class="row-desc">Auto-reply when someone says "lw"</div><span class="row-cmd">.alw on/off</span></div>
        <label class="toggle"><input type="checkbox" id="alw" onchange="toggleFeature('alw',this.checked)"><span class="slider"></span></label>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Snipe Logging <span class="status-dot dot-off" id="dot-snipe"></span></div><div class="row-desc">Log deleted messages for .snipe command</div><span class="row-cmd">.snipe</span></div>
        <label class="toggle"><input type="checkbox" id="snipe" onchange="toggleFeature('snipe',this.checked)"><span class="slider"></span></label>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Ping Insults <span class="status-dot dot-off" id="dot-pinginsult"></span></div><div class="row-desc">Reply with insults when pinged</div><span class="row-cmd">.pinginsult toggle</span></div>
        <label class="toggle"><input type="checkbox" id="pinginsult" onchange="toggleFeature('pinginsult',this.checked)"><span class="slider"></span></label>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Anti-AFK <span class="status-dot dot-off" id="dot-antiafk"></span></div><div class="row-desc">Send typing every few seconds to prevent AFK kick</div><span class="row-cmd">.antiafk [secs] / .afke</span></div>
        <div class="row-actions">
          <input type="number" class="inp" id="antiafkInterval" placeholder="Interval (s)" value="10" style="width:110px">
          <button class="btn btn-p" onclick="toggleAntiAfk('on')">Enable</button>
          <button class="btn btn-d" onclick="toggleAntiAfk('off')">Disable</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Trigger Typing</div><div class="row-desc">Show typing indicator on a loop</div><span class="row-cmd">.triggertyping [secs] / .triggertypingoff</span></div>
        <div class="row-actions">
          <button class="btn btn-p" onclick="efApi('/api/extra-features/toggle',{key:'triggertyping',value:true})">Enable</button>
          <button class="btn btn-d" onclick="efApi('/api/extra-features/toggle',{key:'triggertyping',value:false})">Disable</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Bump</div><div class="row-desc">Auto-run !d bump every interval</div><span class="row-cmd">.autobump [mins] / .autobumpoff</span></div>
        <div class="row-actions">
          <input type="number" class="inp" id="bumpInterval" placeholder="Interval (m)" value="120" style="width:110px">
          <button class="btn btn-p" onclick="efApi('/api/extra-features/toggle',{key:'autobump',value:true})">Enable</button>
          <button class="btn btn-d" onclick="efApi('/api/extra-features/toggle',{key:'autobump',value:false})">Disable</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 2. STFU / AUTODELETE ── -->
  <div class="section searchable" data-keywords="stfu auto delete autodele user messages">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🔇 STFU — Auto-delete User Messages <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="input-group">
        <input type="text" class="inp" id="stfuUserId" placeholder="User ID">
        <button class="btn btn-p" onclick="stfuAction('on')">Enable</button>
        <button class="btn btn-d" onclick="stfuAction('off')">Disable</button>
      </div>
      <div class="row-desc" style="margin-top:8px;color:#555">Auto-deletes every message from the specified user. Use with care — selfbot only.</div>
    </div>
  </div>

  <!-- ── 3. AUTO REPLY / ARR ── -->
  <div class="section searchable" data-keywords="arr auto reply flood dreact autoreact mimic">
    <div class="section-title section-toggle" onclick="toggleSection(this)">💬 Auto Reply & Reactions <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Reply (ARR)</div><div class="row-desc">Auto-reply with random insults to a user</div><span class="row-cmd">.arr @user / .arrend</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="arrUserId" placeholder="User ID">
          <button class="btn btn-p" onclick="arrAction('on')">Enable</button>
          <button class="btn btn-d" onclick="arrAction('off')">Disable</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Mimic User</div><div class="row-desc">Mirror everything a user says</div><span class="row-cmd">.mimic @user / .mimicoff</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="mimicUserId" placeholder="User ID">
          <button class="btn btn-p" onclick="mimicAction('on')">Start</button>
          <button class="btn btn-d" onclick="mimicAction('off')">Stop</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Dreact</div><div class="row-desc">React to every message from a user with cycling emojis</div><span class="row-cmd">.dreact @user 😂 💀 🔥</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="dreactUserId" placeholder="User ID">
          <input type="text" class="inp" id="dreactEmojis" placeholder="Emojis (comma-separated)">
          <button class="btn btn-p" onclick="dreactAction('on')">Enable</button>
          <button class="btn btn-d" onclick="dreactAction('off')">Disable</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Autoreact</div><div class="row-desc">React to every message from a user with one emoji</div><span class="row-cmd">.autoreact @user 😂</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="autoreactUserId" placeholder="User ID">
          <input type="text" class="inp" id="autoreactEmoji" placeholder="Emoji">
          <button class="btn btn-p" onclick="autoreactAction('on')">Enable</button>
          <button class="btn btn-d" onclick="autoreactAction('off')">Disable</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Flood</div><div class="row-desc">Reply to every message from a user with a flood message</div><span class="row-cmd">.autoflood @user msg / .stopautoflood</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="autofloodUserId" placeholder="User ID">
          <input type="text" class="inp" id="autofloodMsg" placeholder="Message">
          <button class="btn btn-p" onclick="autofloodAction('on')">Enable</button>
          <button class="btn btn-d" onclick="autofloodAction('off')">Disable</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Blackify</div><div class="row-desc">Reply to user with racial "jokes" + reactions</div><span class="row-cmd">.blackify @user / .unblackify @user</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="blackifyUserId" placeholder="User ID">
          <button class="btn btn-p" onclick="blackifyAction('on')">Enable</button>
          <button class="btn btn-d" onclick="blackifyAction('off')">Disable</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 4. ATTACK TOOLS ── -->
  <div class="section searchable" data-keywords="murder kill multilast ghost ping spam outlast">
    <div class="section-title section-toggle" onclick="toggleSection(this)">⚔️ Attack Tools <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Murder</div><div class="row-desc">Spam a user with attack messages in a loop</div><span class="row-cmd">.murder @user / .murderstop</span></div>
        <div class="row-actions">
          <button class="btn btn-d" onclick="efApi('/api/extra-features/murder',{action:'on'})">Start</button>
          <button class="btn btn-s" onclick="efApi('/api/extra-features/murder',{action:'off'})">Stop</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Kill (Outlaster)</div><div class="row-desc">Rapid-fire outlast messages at a user</div><span class="row-cmd">.kill @user / .kille</span></div>
        <div class="row-actions">
          <button class="btn btn-d" onclick="efApi('/api/extra-features/kill',{action:'on'})">Start</button>
          <button class="btn btn-s" onclick="efApi('/api/extra-features/kill',{action:'off'})">Stop</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Multilast</div><div class="row-desc">Keep sending last-word messages at extreme speed</div><span class="row-cmd">.multilast @user / .stopmultilast</span></div>
        <div class="row-actions">
          <button class="btn btn-d" onclick="efApi('/api/extra-features/multilast',{action:'on'})">Start</button>
          <button class="btn btn-s" onclick="efApi('/api/extra-features/multilast',{action:'off'})">Stop</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Ghost Ping</div><div class="row-desc">Ping a user then immediately delete the message</div><span class="row-cmd">.ghostping @user [count]</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="ghostpingUserId" placeholder="User ID">
          <input type="number" class="inp" id="ghostpingCount" placeholder="Count" value="1" style="width:70px">
          <button class="btn btn-w" onclick="ghostpingAction()">Send</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 5. PROFILE TOOLS ── -->
  <div class="section searchable" data-keywords="pfp banner bio name display pronoun steal copy profile setpfp setbanner setbio setname setpronoun hypesquad">
    <div class="section-title section-toggle" onclick="toggleSection(this)">👤 Profile Tools <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Set Avatar (PFP)</div><span class="row-cmd">.setpfp &lt;url&gt;</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="pfpUrl" placeholder="Image URL">
          <button class="btn btn-p" onclick="setProfile('pfp')">Set PFP</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Steal PFP</div><span class="row-cmd">.stealpfp @user</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="stealPfpUserId" placeholder="User ID">
          <button class="btn btn-w" onclick="stealPfp()">Steal</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Banner</div><span class="row-cmd">.setbanner &lt;url&gt;</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="bannerUrl" placeholder="Image URL">
          <button class="btn btn-p" onclick="setProfile('banner')">Set Banner</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Display Name</div><span class="row-cmd">.setname &lt;name&gt;</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="displayName" placeholder="Display name">
          <button class="btn btn-p" onclick="setProfile('name')">Set Name</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Bio</div><span class="row-cmd">.setbio &lt;text&gt;</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="bioText" placeholder="Bio text">
          <button class="btn btn-p" onclick="setProfile('bio')">Set Bio</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Pronouns</div><span class="row-cmd">.setpronoun &lt;text&gt;</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="pronounsText" placeholder="he/him, she/her...">
          <button class="btn btn-p" onclick="setPronouns()">Set</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">HypeSquad</div><span class="row-cmd">.hypesquad &lt;house&gt;</span></div>
        <div class="row-actions">
          <button class="btn btn-p" onclick="setHypesquad('bravery')">Bravery</button>
          <button class="btn btn-p" onclick="setHypesquad('brilliance')">Brilliance</button>
          <button class="btn btn-p" onclick="setHypesquad('balance')">Balance</button>
          <button class="btn btn-d" onclick="setHypesquad('off')">Remove</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 6. STATUS TOOLS ── -->
  <div class="section searchable" data-keywords="status rotator setstatus online dnd idle invisible rstatus stopstatus spotify stream">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🔵 Status Tools <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Online Status</div><span class="row-cmd">.setstatus online/dnd/idle/invisible</span></div>
        <div class="row-actions">
          <button class="btn btn-g" onclick="setStatus('online')">Online</button>
          <button class="btn btn-d" onclick="setStatus('dnd')">DND</button>
          <button class="btn btn-w" onclick="setStatus('idle')">Idle</button>
          <button class="btn btn-s" onclick="setStatus('invisible')">Invisible</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Status Rotator</div><div class="row-desc">Rotate through custom statuses every few seconds</div><span class="row-cmd">.rstatus status1, status2 / .stopstatus</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="statusList" placeholder="status1, status2, status3">
          <input type="number" class="inp" id="statusDelay" placeholder="Delay (s)" value="8" style="width:90px">
          <button class="btn btn-p" onclick="statusRotate('on')">Start</button>
          <button class="btn btn-d" onclick="statusRotate('off')">Stop</button>
        </div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Spotify Activity</div><div class="row-desc">Show as listening to a song</div><span class="row-cmd">.spotify &lt;song name&gt;</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="spotifyName" placeholder="Song name">
          <button class="btn btn-p" onclick="efApi('/api/extra-features/setstatus',{status:'online',activity:{type:'LISTENING',name:document.getElementById(\'spotifyName\').value}})">Set</button>
