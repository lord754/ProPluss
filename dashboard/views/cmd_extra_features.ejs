<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Extra Features — THE BIG 5 | PRO+</title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{min-height:100vh;background:#050508;color:#fff;font-family:'Outfit',sans-serif}
.container{width:95%;max-width:980px;margin:0 auto;padding:30px 20px 140px}
.back-btn{position:fixed;top:20px;left:20px;z-index:100;display:inline-flex;align-items:center;gap:8px;padding:9px 16px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:#aaa;text-decoration:none;font-size:.85rem;font-weight:600;transition:.2s}
.back-btn:hover{background:rgba(255,255,255,0.1);color:#fff}
.page-header{text-align:center;margin:60px 0 32px}
.page-header h1{font-size:2.2rem;font-weight:800;background:linear-gradient(135deg,#fff,#a29bfe);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.page-header p{color:#555;font-size:.9rem;margin-top:6px}
.section{background:#111116;border:1px solid rgba(255,255,255,0.07);border-radius:20px;padding:22px;margin-bottom:16px}
.section-title{font-size:.82rem;font-weight:800;color:#a29bfe;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:10px;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.row{display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,0.04);gap:10px;flex-wrap:wrap}
.row:last-child{border-bottom:none}
.row-info{flex:1;min-width:0}
.row-name{color:#fff;font-size:.9rem;font-weight:600}
.row-desc{color:#555;font-size:.76rem;margin-top:2px}
.row-cmd{font-family:monospace;font-size:.72rem;color:#6c5ce7;background:rgba(108,92,231,0.1);padding:2px 6px;border-radius:4px;margin-top:3px;display:inline-block}
.row-actions{display:flex;gap:7px;align-items:center;flex-shrink:0;flex-wrap:wrap}
.toggle{position:relative;width:44px;height:23px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.slider{position:absolute;inset:0;background:#1e1e2e;border:1px solid rgba(255,255,255,0.1);border-radius:23px;cursor:pointer;transition:.3s}
.slider:before{content:'';position:absolute;width:17px;height:17px;left:2px;top:2px;background:#555;border-radius:50%;transition:.3s}
input:checked+.slider{background:linear-gradient(90deg,#8a2be2,#6c5ce7);border-color:transparent}
input:checked+.slider:before{background:#fff;transform:translateX(21px)}
.inp{flex:1;min-width:100px;padding:8px 12px;background:#050508;border:1px solid rgba(255,255,255,0.08);color:#fff;border-radius:9px;outline:none;font-family:'Outfit',sans-serif;font-size:.85rem;transition:.2s}
.inp:focus{border-color:#8a2be2}
.inp::placeholder{color:#333}
.btn{padding:7px 14px;border:none;border-radius:9px;font-weight:700;cursor:pointer;font-size:.78rem;transition:.2s;font-family:'Outfit',sans-serif;white-space:nowrap}
.btn:disabled{opacity:.35;cursor:not-allowed}
.btn-p{background:linear-gradient(90deg,#8a2be2,#6c5ce7);color:#fff}
.btn-p:not(:disabled):hover{filter:brightness(1.15)}
.btn-d{background:rgba(231,76,60,0.1);color:#e74c3c;border:1px solid rgba(231,76,60,0.2)}
.btn-d:not(:disabled):hover{background:#e74c3c;color:#fff}
.btn-s{background:rgba(255,255,255,0.05);color:#aaa;border:1px solid rgba(255,255,255,0.08)}
.btn-s:not(:disabled):hover{background:rgba(255,255,255,0.1);color:#fff}
.btn-w{background:rgba(243,156,18,0.1);color:#f39c12;border:1px solid rgba(243,156,18,0.2)}
.btn-w:not(:disabled):hover{background:#f39c12;color:#fff}
.btn-g{background:rgba(46,204,113,0.1);color:#2ecc71;border:1px solid rgba(46,204,113,0.2)}
.btn-g:not(:disabled):hover{background:#2ecc71;color:#000}
.btn-b{background:rgba(52,152,219,0.1);color:#3498db;border:1px solid rgba(52,152,219,0.2)}
.btn-b:not(:disabled):hover{background:#3498db;color:#fff}
.input-group{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.input-group .inp{min-width:140px}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.result-box{background:#050508;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:10px 14px;font-size:.8rem;color:#888;font-family:monospace;margin-top:10px;display:none;white-space:pre-wrap;word-break:break-all}
.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:#1e1e2e;border:1px solid rgba(138,43,226,0.4);color:#fff;padding:12px 24px;border-radius:12px;font-size:.88rem;opacity:0;transition:.3s;pointer-events:none;z-index:9999;max-width:360px;text-align:center}
.toast.show{opacity:1}
.status-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dot-on{background:#2ecc71;box-shadow:0 0 5px rgba(46,204,113,0.6)}
.dot-off{background:#555}
.search-bar{width:100%;padding:11px 16px;background:#0d0d12;border:1px solid rgba(255,255,255,0.08);color:#fff;border-radius:12px;outline:none;font-family:'Outfit',sans-serif;font-size:.9rem;margin-bottom:20px;transition:.2s}
.search-bar:focus{border-color:#8a2be2}
.search-bar::placeholder{color:#333}
.cat-badge{font-size:.66rem;font-weight:800;padding:2px 7px;border-radius:8px;text-transform:uppercase;letter-spacing:.4px}
.cat-red{background:rgba(231,76,60,0.15);color:#e74c3c;border:1px solid rgba(231,76,60,0.25)}
.cat-purple{background:rgba(138,43,226,0.12);color:#c084fc;border:1px solid rgba(138,43,226,0.2)}
.cat-green{background:rgba(46,204,113,0.1);color:#2ecc71;border:1px solid rgba(46,204,113,0.2)}
.cat-blue{background:rgba(52,152,219,0.12);color:#3498db;border:1px solid rgba(52,152,219,0.2)}
.cat-orange{background:rgba(243,156,18,0.1);color:#f39c12;border:1px solid rgba(243,156,18,0.2)}
.cat-cyan{background:rgba(0,206,209,0.1);color:#00ced1;border:1px solid rgba(0,206,209,0.2)}
.section-toggle{cursor:pointer;user-select:none}
.section-toggle:hover .section-title{color:#c084fc}
.section-body{transition:max-height .3s ease;overflow:hidden}
.chevron{font-size:.7rem;color:#555;margin-left:auto;transition:transform .2s}
.chevron.open{transform:rotate(180deg)}
@media(max-width:560px){.row{flex-direction:column;align-items:flex-start}.row-actions{width:100%}}
</style>
</head>
<body>
<a href="/commands" class="back-btn">← Back</a>
<div class="toast" id="toast"></div>
<div class="container">
  <div class="page-header">
    <h1>⚡ Extra Features</h1>
    <p>Full Big5 control panel — all commands accessible from dashboard · v<%= locals.botVersion || '2.2.1a' %> Alpha</p>
  </div>

  <input type="text" class="search-bar" id="searchBar" placeholder="🔍 Search commands..." oninput="filterSections()">


  <!-- ══════════════════════════════════════════════════════
       1. AUTO FEATURES
  ══════════════════════════════════════════════════════ -->
  <div class="section searchable" data-keywords="agct anti gc silent alw last word stfu autodelete dreact autoreact autoflood arr auto reply mimic blackify antiafk triggertyping autobump autoedit cord cap autoflood">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🛡️ Auto Features <span class="chevron open">▼</span></div>
    <div class="section-body">

      <!-- Anti-GC -->
      <div class="row">
        <div class="row-info"><div class="row-name">Anti-GC Trap</div><div class="row-desc">Auto-leave + block when added to a group chat</div><span class="row-cmd">.agct on/off</span></div>
        <label class="toggle"><input type="checkbox" id="agct" onchange="sendCmd('agct '+(this.checked?'on':'off'))"><span class="slider"></span></label>
      </div>
      <!-- Silent Anti-GC -->
      <div class="row">
        <div class="row-info"><div class="row-name">Silent Anti-GC</div><div class="row-desc">Silently leave group chats without blocking</div><span class="row-cmd">.silentantigc on/off</span></div>
        <label class="toggle"><input type="checkbox" id="silentantigc" onchange="sendCmd('silentantigc '+(this.checked?'on':'off'))"><span class="slider"></span></label>
      </div>
      <!-- ALW -->
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Last Word (ALW)</div><div class="row-desc">Auto-reply when someone says "lw"</div><span class="row-cmd">.alw on/off</span></div>
        <label class="toggle"><input type="checkbox" id="alw" onchange="sendCmd('alw '+(this.checked?'on':'off'))"><span class="slider"></span></label>
      </div>
      <!-- ALW Whitelist -->
      <div class="row">
        <div class="row-info"><div class="row-name">ALW Whitelist</div><div class="row-desc">Add user to ALW whitelist (won't trigger on them)</div><span class="row-cmd">.wl &lt;user_id&gt;</span></div>
        <div class="row-actions"><input class="inp" id="alwWlId" placeholder="User ID" style="width:140px"><button class="btn btn-p" onclick="sendCmd('wl '+document.getElementById('alwWlId').value)">Whitelist</button></div>
      </div>

      <!-- STFU -->
      <div class="row">
        <div class="row-info"><div class="row-name">STFU (Auto-delete messages)</div><div class="row-desc">Auto-delete every message from a user in this channel</div><span class="row-cmd">.stfu @user / .stfuoff @user</span></div>
        <div class="row-actions"><input class="inp" id="stfuUserId" placeholder="User ID" style="width:130px"><button class="btn btn-p" onclick="stfuAction('on')">Enable</button><button class="btn btn-d" onclick="stfuAction('off')">Disable</button></div>
      </div>

      <!-- Auto Reply (ARR) -->
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Reply (ARR)</div><div class="row-desc">Continuously auto-reply to a user</div><span class="row-cmd">.arr @user / .arrend</span></div>
        <div class="row-actions"><input class="inp" id="arrUserId" placeholder="User ID" style="width:130px"><button class="btn btn-p" onclick="arrAction('on')">Enable</button><button class="btn btn-d" onclick="arrAction('off')">Disable</button></div>
      </div>
      <!-- AR1 Custom Reply -->
      <div class="row">
        <div class="row-info"><div class="row-name">AR1 — Custom Reply List</div><div class="row-desc">Reply with custom messages to a user (comma-separated)</div><span class="row-cmd">.ar1 @user text1, text2</span></div>
        <div class="row-actions">
          <input class="inp" id="ar1User" placeholder="User ID" style="width:110px">
          <input class="inp" id="ar1Text" placeholder="reply1, reply2, ..." style="width:180px">
          <button class="btn btn-p" onclick="sendCmd('ar1 '+document.getElementById('ar1User').value+' '+document.getElementById('ar1Text').value)">Set</button>
        </div>
      </div>
      <!-- AR2 Spaced Reply -->
      <div class="row">
        <div class="row-info"><div class="row-name">AR2 — Spaced Reply</div><div class="row-desc">Reply with spaced-out messages to a user</div><span class="row-cmd">.ar2 @user text</span></div>
        <div class="row-actions">
          <input class="inp" id="ar2User" placeholder="User ID" style="width:110px">
          <input class="inp" id="ar2Text" placeholder="reply text" style="width:180px">
          <button class="btn btn-p" onclick="sendCmd('ar2 '+document.getElementById('ar2User').value+' '+document.getElementById('ar2Text').value)">Set</button>
        </div>
      </div>

      <!-- Dreact -->
      <div class="row">
        <div class="row-info"><div class="row-name">Dreact</div><div class="row-desc">Cycle through emojis on a user's messages</div><span class="row-cmd">.dreact @user 😂 😭 / .dreactoff @user</span></div>
        <div class="row-actions">
          <input class="inp" id="dreactUserId" placeholder="User ID" style="width:110px">
          <input class="inp" id="dreactEmojis" placeholder="😂 😭 🔥" style="width:110px">
          <button class="btn btn-p" onclick="dreactAction('on')">Start</button>
          <button class="btn btn-d" onclick="dreactAction('off')">Stop</button>
        </div>
      </div>
      <!-- Autoreact -->
      <div class="row">
        <div class="row-info"><div class="row-name">Autoreact</div><div class="row-desc">Auto-react with an emoji to a user's messages</div><span class="row-cmd">.autoreact @user 😂 / .autoreactoff @user</span></div>
        <div class="row-actions">
          <input class="inp" id="autoreactUserId" placeholder="User ID" style="width:110px">
          <input class="inp" id="autoreactEmoji" placeholder="😂" style="width:70px">
          <button class="btn btn-p" onclick="autoreactAction('on')">Start</button>
          <button class="btn btn-d" onclick="autoreactAction('off')">Stop</button>
        </div>
      </div>

      <!-- Autoflood -->
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Flood</div><div class="row-desc">Flood-reply every message from a user</div><span class="row-cmd">.autoflood @user message / .stopautoflood @user</span></div>
        <div class="row-actions">
          <input class="inp" id="autofloodUserId" placeholder="User ID" style="width:110px">
          <input class="inp" id="autofloodMsg" placeholder="flood message" style="width:150px">
          <button class="btn btn-p" onclick="autofloodAction('on')">Start</button>
          <button class="btn btn-d" onclick="autofloodAction('off')">Stop</button>
        </div>
      </div>

      <!-- Mimic -->
      <div class="row">
        <div class="row-info"><div class="row-name">Mimic</div><div class="row-desc">Copy and resend everything a user types</div><span class="row-cmd">.mimic @user / .mimicoff</span></div>
        <div class="row-actions"><input class="inp" id="mimicUserId" placeholder="User ID" style="width:130px"><button class="btn btn-p" onclick="mimicAction('on')">Start</button><button class="btn btn-d" onclick="mimicAction('off')">Stop</button></div>
      </div>

      <!-- Blackify -->
      <div class="row">
        <div class="row-info"><div class="row-name">Blackify</div><div class="row-desc">Spam reaction emojis on a user's messages</div><span class="row-cmd">.blackify @user / .unblackify @user</span></div>
        <div class="row-actions"><input class="inp" id="blackifyUserId" placeholder="User ID" style="width:130px"><button class="btn btn-p" onclick="blackifyAction('on')">Start</button><button class="btn btn-d" onclick="blackifyAction('off')">Stop</button></div>
      </div>

      <!-- Anti-AFK -->
      <div class="row">
        <div class="row-info"><div class="row-name">Anti-AFK Monitor</div><div class="row-desc">Watch a user and auto-respond to AFK checks</div><span class="row-cmd">.antiafk @user / .afke @user</span></div>
        <div class="row-actions"><input class="inp" id="antiAfkUserId" placeholder="User ID" style="width:130px"><button class="btn btn-p" onclick="antiAfkAction('on')">Start</button><button class="btn btn-d" onclick="antiAfkAction('off')">Stop</button></div>
      </div>
      <!-- AFK Check -->
      <div class="row">
        <div class="row-info"><div class="row-name">AFK Check Ping</div><div class="row-desc">Ping a user N times to check if AFK</div><span class="row-cmd">.afkcheck @user &lt;count&gt; / .afkcheckoff @user</span></div>
        <div class="row-actions">
          <input class="inp" id="afkCheckUserId" placeholder="User ID" style="width:110px">
          <input class="inp" id="afkCheckCount" placeholder="Count" type="number" style="width:70px" value="5">
          <button class="btn btn-p" onclick="sendCmd('afkcheck '+document.getElementById('afkCheckUserId').value+' '+document.getElementById('afkCheckCount').value)">Start</button>
          <button class="btn btn-d" onclick="sendCmd('afkcheckoff '+document.getElementById('afkCheckUserId').value)">Stop</button>
        </div>
      </div>

      <!-- Trigger Typing -->
      <div class="row">
        <div class="row-info"><div class="row-name">Trigger Typing</div><div class="row-desc">Show "typing..." in a channel for a duration</div><span class="row-cmd">.triggertyping 30s / .triggertypingoff</span></div>
        <div class="row-actions">
          <input class="inp" id="triggerTypingDur" placeholder="30s / 5m" style="width:90px">
          <button class="btn btn-p" onclick="sendCmd('triggertyping '+document.getElementById('triggerTypingDur').value)">Start</button>
          <button class="btn btn-d" onclick="sendCmd('triggertypingoff')">Stop</button>
        </div>
      </div>

      <!-- Ping Response -->
      <div class="row">
        <div class="row-info"><div class="row-name">Ping Response</div><div class="row-desc">Auto-reply when you get pinged in a channel</div><span class="row-cmd">.pingresponse toggle / set &lt;response&gt;</span></div>
        <div class="row-actions">
          <input class="inp" id="pingRespText" placeholder="Auto-response text" style="width:200px">
          <button class="btn btn-p" onclick="sendCmd('pingresponse set '+document.getElementById('pingRespText').value)">Set</button>
          <button class="btn btn-s" onclick="sendCmd('pingresponse toggle')">Toggle</button>
        </div>
      </div>

      <!-- Auto Bump -->
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Bump</div><div class="row-desc">Automatically bump server every 2 hours</div><span class="row-cmd">.autobump / .autobumpoff</span></div>
        <div class="row-actions"><button class="btn btn-p" onclick="sendCmd('autobump')">Start</button><button class="btn btn-d" onclick="sendCmd('autobumpoff')">Stop</button></div>
      </div>

      <!-- Auto Edit -->
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Edit</div><div class="row-desc">Automatically edit your messages</div><span class="row-cmd">.autoedit / .autoeditoff</span></div>
        <div class="row-actions"><button class="btn btn-p" onclick="sendCmd('autoedit')">Enable</button><button class="btn btn-d" onclick="sendCmd('autoeditoff')">Disable</button></div>
      </div>

      <!-- Cord Mode -->
      <div class="row">
        <div class="row-info"><div class="row-name">Cord Mode</div><div class="row-desc">Mirror messages to another user like a cord</div><span class="row-cmd">.cord @user / .cordoff</span></div>
        <div class="row-actions"><input class="inp" id="cordUserId" placeholder="User ID" style="width:130px"><button class="btn btn-p" onclick="sendCmd('cord '+document.getElementById('cordUserId').value)">Enable</button><button class="btn btn-d" onclick="sendCmd('cordoff')">Disable</button></div>
      </div>

      <!-- Cap Mode -->
      <div class="row">
        <div class="row-info"><div class="row-name">Auto Capitalism</div><div class="row-desc">AlTeRnAtE cApS on every message you send</div><span class="row-cmd">.cap (toggle)</span></div>
        <div class="row-actions"><button class="btn btn-p" onclick="sendCmd('cap')">Toggle</button></div>
      </div>

      <!-- Webhook Copy -->
      <div class="row">
        <div class="row-info"><div class="row-name">Webhook Copy</div><div class="row-desc">Automatically copy messages via webhook</div><span class="row-cmd">.webhookcopy / .webhookcopyoff</span></div>
        <div class="row-actions"><button class="btn btn-p" onclick="sendCmd('webhookcopy')">Enable</button><button class="btn btn-d" onclick="sendCmd('webhookcopyoff')">Disable</button></div>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       2. SNIPE & LOGGING
  ══════════════════════════════════════════════════════ -->
  <div class="section searchable" data-keywords="snipe deleted messages log display clearlog logging displaylog">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🔍 Snipe &amp; Logging <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Snipe Logging</div><div class="row-desc">Log deleted messages for the snipe command</div><span class="row-cmd">.snipe</span></div>
        <div class="row-actions"><button class="btn btn-p" onclick="sendCmd('snipe')">Snipe Last</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Message Logger</div><div class="row-desc">Log all DMs and GC messages to file</div><span class="row-cmd">.log on/off</span></div>
        <div class="row-actions"><button class="btn btn-p" onclick="sendCmd('log on')">Enable</button><button class="btn btn-d" onclick="sendCmd('log off')">Disable</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Display Log Entry</div><div class="row-desc">Show a specific log entry by number</div><span class="row-cmd">.display &lt;number&gt;</span></div>
        <div class="row-actions"><input class="inp" id="logNum" placeholder="Log #" type="number" style="width:80px"><button class="btn btn-p" onclick="sendCmd('display '+document.getElementById('logNum').value)">Show</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Display Full Log</div><div class="row-desc">Show entire message log file</div><span class="row-cmd">.displaylog</span></div>
        <div class="row-actions"><button class="btn btn-b" onclick="sendCmd('displaylog')">View Log</button><button class="btn btn-d" onclick="sendCmd('clearlog')">Clear Log</button></div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       3. PROFILE TOOLS
  ══════════════════════════════════════════════════════ -->
  <div class="section searchable" data-keywords="profile pfp avatar banner bio name pronoun steal copy backup setpfp setbanner setname setbio setpronoun copyprofile pbackup stealpfp stealbanner stealbio stealpronoun setspfp setsbanner setsbio setspronoun server profile">
    <div class="section-title section-toggle" onclick="toggleSection(this)">👤 Profile Tools <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Set Avatar (PFP)</div><div class="row-desc">Change your profile picture via URL</div><span class="row-cmd">.setpfp &lt;url&gt;</span></div>
        <div class="row-actions"><input class="inp" id="pfpUrl" placeholder="Avatar URL" style="width:220px"><button class="btn btn-p" onclick="setProfile('pfp')">Set PFP</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Banner</div><div class="row-desc">Change your profile banner via URL</div><span class="row-cmd">.setbanner &lt;url&gt;</span></div>
        <div class="row-actions"><input class="inp" id="bannerUrl" placeholder="Banner URL" style="width:220px"><button class="btn btn-p" onclick="setProfile('banner')">Set Banner</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Display Name</div><div class="row-desc">Change your global display name</div><span class="row-cmd">.setname &lt;name&gt;</span></div>
        <div class="row-actions"><input class="inp" id="displayName" placeholder="Display name" style="width:220px"><button class="btn btn-p" onclick="setProfile('name')">Set Name</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Set Bio</div><div class="row-desc">Change your profile bio text</div><span class="row-cmd">.setbio &lt;text&gt;</span></div>
