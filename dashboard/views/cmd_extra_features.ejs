  <!-- ── 9. TOKEN TOOLS ── -->
  <div class="section searchable" data-keywords="token check tokuser tinfo valid invalid ct tjoin">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🔑 Token Tools <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Token Lookup</div><div class="row-desc">Get user info from any token</div><span class="row-cmd">.tokuser &lt;token&gt; / .tinfo / .tc</span></div>
        <div class="row-actions">
          <input type="text" class="inp" id="tokenInput" placeholder="Discord token">
          <button class="btn btn-p" onclick="tokenLookup()">Lookup</button>
