    </div>
  </div>

</div>

<div class="toast" id="toast"></div>
<%- include('partials/super_button') %>

<script>
// ── Toast ─────────────────────────────────────────────────────────────────────
function showToast(msg, ok=true) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.borderColor = ok ? 'rgba(138,43,226,0.4)' : 'rgba(231,76,60,0.4)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ── Generic API call ──────────────────────────────────────────────────────────
async function efApi(path, body) {
  try {
    const r = await fetch(path, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const d = await r.json();
    if (d.success) showToast(d.message || '✅ Done');
    else showToast('❌ ' + (d.error || 'Error'), false);
    return d;
  } catch(e) { showToast('❌ ' + e.message, false); return {}; }
}

// ── Section toggle ────────────────────────────────────────────────────────────
function toggleSection(el) {
  const body = el.nextElementSibling;
  const chev = el.querySelector('.chevron');
  const open = body.style.maxHeight !== '0px' && body.style.maxHeight !== '';
  body.style.maxHeight = open ? '0px' : body.scrollHeight + 'px';
  if (chev) chev.classList.toggle('open', !open);
}
// Open all by default
document.querySelectorAll('.section-body').forEach(b => b.style.maxHeight = b.scrollHeight + 'px');

// ── Search ────────────────────────────────────────────────────────────────────
function filterSections() {
  const q = document.getElementById('searchBar').value.toLowerCase();
  document.querySelectorAll('.searchable').forEach(s => {
    const kw = (s.dataset.keywords || '') + ' ' + s.textContent;
    s.style.display = q && !kw.toLowerCase().includes(q) ? 'none' : '';
  });
}

// ── Load state ────────────────────────────────────────────────────────────────
async function loadState() {
  try {
    const d = await fetch('/api/extra-features').then(r=>r.json());
    ['agct','silentantigc','alw','snipe','pinginsult'].forEach(k => {
      const el = document.getElementById(k);
      if (el) el.checked = !!d[k];
    });
  } catch(e) {}
}

// ── Auto features ─────────────────────────────────────────────────────────────
async function toggleFeature(key, val) {
  const r = await efApi('/api/extra-features/toggle', { key, value: val });
  if (r.success) showToast(`${key}: ${val ? 'ON' : 'OFF'}`);
}
async function stfuAction(action) {
  const id = document.getElementById('stfuUserId').value.trim();
  if (!id) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/stfu', { userId: id, action });
}
async function arrAction(action) {
  const id = document.getElementById('arrUserId').value.trim();
  if (!id) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/arr', { userId: id, action });
}
async function mimicAction(action) {
  const id = document.getElementById('mimicUserId').value.trim();
  if (action === 'on' && !id) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/mimic', { userId: id, action });
}
async function dreactAction(action) {
  const uid = document.getElementById('dreactUserId').value.trim();
  const emojis = document.getElementById('dreactEmojis').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/dreact', { userId: uid, emojis, action });
}
async function autoreactAction(action) {
  const uid = document.getElementById('autoreactUserId').value.trim();
  const emoji = document.getElementById('autoreactEmoji').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/autoreact', { userId: uid, emoji, action });
}
async function autofloodAction(action) {
  const uid = document.getElementById('autofloodUserId').value.trim();
  const msg = document.getElementById('autofloodMsg').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/autoflood', { userId: uid, message: msg, action });
}
async function blackifyAction(action) {
  const uid = document.getElementById('blackifyUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/blackify', { userId: uid, action });
}
async function ghostpingAction() {
  const uid = document.getElementById('ghostpingUserId').value.trim();
  const count = parseInt(document.getElementById('ghostpingCount').value) || 1;
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/ghostping', { userId: uid, count });
}
async function toggleAntiAfk(action) {
  const interval = parseInt(document.getElementById('antiafkInterval').value) || 10;
  await efApi('/api/extra-features/toggle', { key: 'antiafk', value: action === 'on', interval });
}
async function autonickAction(action) {
  const uid = document.getElementById('forceNickUserId').value.trim();
  const nick = document.getElementById('forceNickName').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/autonick', { userId: uid, nick, action });
}

// ── Profile ───────────────────────────────────────────────────────────────────
async function setProfile(type) {
  const map = { pfp:'pfpUrl', banner:'bannerUrl', name:'displayName', bio:'bioText' };
  const val = document.getElementById(map[type])?.value.trim();
  if (!val) return showToast('Enter a value', false);
  await efApi('/api/extra-features/profile', { type, value: val });
}
async function stealPfp() {
  const uid = document.getElementById('stealPfpUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/stealpfp', { userId: uid });
}
async function setPronouns() {
  const p = document.getElementById('pronounsText').value.trim();
  await efApi('/api/extra-features/pronouns', { pronouns: p });
}
async function setHypesquad(house) {
  await efApi('/api/extra-features/hypesquad', { house });
}

// ── Status ────────────────────────────────────────────────────────────────────
async function setStatus(status) {
  await efApi('/api/extra-features/setstatus', { status });
}
async function statusRotate(action) {
  const statuses = document.getElementById('statusList').value.trim();
  const delay = parseInt(document.getElementById('statusDelay').value) || 8;
  await efApi('/api/extra-features/status-rotator', { statuses, delay, action });
}

// ── Friend / Block ────────────────────────────────────────────────────────────
async function friendAction(action) {
  const uid = document.getElementById('friendUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/friend', { userId: uid, action });
}
async function blockAction(action) {
  const uid = document.getElementById('blockUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  await efApi('/api/extra-features/block', { userId: uid, action });
}

// ── Token lookup ──────────────────────────────────────────────────────────────
async function tokenLookup() {
  const tok = document.getElementById('tokenInput').value.trim();
  if (!tok) return showToast('Enter a token', false);
  const r = await efApi('/api/extra-features/tokuser', { token: tok });
  const box = document.getElementById('tokenResult');
  if (r.success && r.user) {
    const u = r.user;
    box.textContent = `Username: ${u.username}\nID: ${u.id}\nEmail: ${u.email}\nNitro: ${u.nitro}\nMFA: ${u.mfa}\nPhone: ${u.phone}\nVerified: ${u.verified}`;
    box.style.display = 'block';
  } else {
    box.textContent = 'Invalid or failed.';
    box.style.display = 'block';
  }
}

loadState();
</script>
</body>
</html>
