        <div class="row-info"><div class="row-name">Clear Console</div><div class="row-desc">Clear the bot console display (cls)</div><span class="row-cmd">.cls</span></div>
        <div class="row-actions"><button class="btn btn-s" onclick="sendCmd('cls')">Clear Console</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">UGC End</div><div class="row-desc">Stop the group chat name changer loop</div><span class="row-cmd">.ugcend</span></div>
        <div class="row-actions"><button class="btn btn-d" onclick="sendCmd('ugcend')">Stop GC Rename</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Auto React (Self React)</div><div class="row-desc">Toggle auto reaction on your own messages</div><span class="row-cmd">.autoreact @user emoji</span></div>
      </div>
    </div>
  </div>
  <!-- ══════════════════════════════════════════════════════
       15. ENVIRONMENT CHANGE
  ══════════════════════════════════════════════════════ -->
  <div class="section searchable" data-keywords="env environment change config prefix lavalink password ai api username password port public url settings">
    <div class="section-title section-toggle" onclick="toggleSection(this)">⚙️ Environment Change (.env) <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row">
        <div class="row-info"><div class="row-name">Bot Prefix</div><div class="row-desc">Change the bot command prefix (currently in .env as PREFIX)</div></div>
        <div class="row-actions"><input class="inp" id="envPrefix" placeholder="e.g. ." style="width:100px"><button class="btn btn-p" onclick="setEnv('PREFIX', document.getElementById('envPrefix').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Dashboard Username</div><div class="row-desc">Change the dashboard login username (APP_USER)</div></div>
        <div class="row-actions"><input class="inp" id="envUser" placeholder="New username" style="width:180px"><button class="btn btn-p" onclick="setEnv('APP_USER', document.getElementById('envUser').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Dashboard Password</div><div class="row-desc">Change the dashboard login password (APP_PASS)</div></div>
        <div class="row-actions"><input class="inp" id="envPass" placeholder="New password" type="password" style="width:180px"><button class="btn btn-p" onclick="setEnv('APP_PASS', document.getElementById('envPass').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Dashboard Port</div><div class="row-desc">Change the HTTP port the dashboard listens on (PORT)</div></div>
        <div class="row-actions"><input class="inp" id="envPort" placeholder="e.g. 3000" type="number" style="width:100px"><button class="btn btn-p" onclick="setEnv('PORT', document.getElementById('envPort').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">AI API Key</div><div class="row-desc">Set the NVIDIA / AI API key (AI_API)</div></div>
        <div class="row-actions"><input class="inp" id="envAiApi" placeholder="API key" type="password" style="width:240px"><button class="btn btn-p" onclick="setEnv('AI_API', document.getElementById('envAiApi').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Lavalink WS</div><div class="row-desc">Set the Lavalink websocket URL (LAVALINK_WS)</div></div>
        <div class="row-actions"><input class="inp" id="envLwsUrl" placeholder="ws://host:port/v4/websocket" style="width:280px"><button class="btn btn-p" onclick="setEnv('LAVALINK_WS', document.getElementById('envLwsUrl').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Lavalink REST</div><div class="row-desc">Set the Lavalink REST URL (LAVALINK_REST)</div></div>
        <div class="row-actions"><input class="inp" id="envLrestUrl" placeholder="http://host/v4" style="width:240px"><button class="btn btn-p" onclick="setEnv('LAVALINK_REST', document.getElementById('envLrestUrl').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Lavalink Password</div><div class="row-desc">Set the Lavalink password (LAVALINK_PASSWORD)</div></div>
        <div class="row-actions"><input class="inp" id="envLpass" placeholder="Password" type="password" style="width:200px"><button class="btn btn-p" onclick="setEnv('LAVALINK_PASSWORD', document.getElementById('envLpass').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Public URL</div><div class="row-desc">Set the public dashboard URL (PUBLIC_URL)</div></div>
        <div class="row-actions"><input class="inp" id="envPublicUrl" placeholder="https://example.com" style="width:240px"><button class="btn btn-p" onclick="setEnv('PUBLIC_URL', document.getElementById('envPublicUrl').value)">Save</button></div>
      </div>
      <div class="row">
        <div class="row-info"><div class="row-name">Client Name</div><div class="row-desc">Set the bot client name shown in logs (CLIENT_NAME)</div></div>
        <div class="row-actions"><input class="inp" id="envClientName" placeholder="e.g. ProPlus" style="width:160px"><button class="btn btn-p" onclick="setEnv('CLIENT_NAME', document.getElementById('envClientName').value)">Save</button></div>
      </div>
      <div id="envResult" class="result-box"></div>
    </div>
  </div>

</div><!-- .container -->


<script>
// ── Toast ─────────────────────────────────────────────────────────────────────
function showToast(msg, ok = true) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.borderColor = ok ? 'rgba(138,43,226,0.4)' : 'rgba(231,76,60,0.4)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ── Section toggle ─────────────────────────────────────────────────────────────
function toggleSection(titleEl) {
  const body = titleEl.parentElement.querySelector('.section-body');
  const ch   = titleEl.querySelector('.chevron');
  const open = ch.classList.toggle('open');
  body.style.maxHeight = open ? null : '0px';
  body.style.overflow  = open ? 'visible' : 'hidden';
}

// ── Search ─────────────────────────────────────────────────────────────────────
function filterSections() {
  const q = document.getElementById('searchBar').value.toLowerCase();
  document.querySelectorAll('.searchable').forEach(sec => {
    const kw = (sec.dataset.keywords || '') + ' ' + sec.textContent;
    sec.style.display = kw.toLowerCase().includes(q) ? '' : 'none';
  });
}

// ── API helper ─────────────────────────────────────────────────────────────────
async function efApi(path, body = {}) {
  try {
    const r = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const d = await r.json();
    if (d.success) showToast(d.message || 'Done ✓');
    else showToast(d.error || 'Failed', false);
    return d;
  } catch (e) {
    showToast('Network error', false);
    return { success: false };
  }
}

// ── Send raw command ───────────────────────────────────────────────────────────
function sendCmd(cmd) {
  if (!cmd || !cmd.trim()) return showToast('Nothing to send', false);
  efApi('/api/extra-features/cmd', { command: cmd });
}

// ── Load state ─────────────────────────────────────────────────────────────────
async function loadState() {
  try {
    const r = await fetch('/api/extra-features/state');
    const d = await r.json();
    if (!d.success) return;
    const s = d.state || {};
    const map = { agct:'agct', silentantigc:'silentantigc', alw:'alw' };
    for (const [key, id] of Object.entries(map)) {
      const el = document.getElementById(id);
      if (el) el.checked = !!s[key];
    }
  } catch {}
}

// ── Feature toggle helpers ─────────────────────────────────────────────────────
function toggleFeature(key, val) {
  efApi('/api/extra-features/toggle', { key, value: val });
}

// ── STFU ──────────────────────────────────────────────────────────────────────
function stfuAction(action) {
  const id = document.getElementById('stfuUserId').value.trim();
  if (!id) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/stfu', { userId: id, action });
}

// ── ARR ───────────────────────────────────────────────────────────────────────
function arrAction(action) {
  const id = document.getElementById('arrUserId').value.trim();
  if (!id) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/arr', { userId: id, action });
}

// ── Mimic ─────────────────────────────────────────────────────────────────────
function mimicAction(action) {
  const id = document.getElementById('mimicUserId').value.trim();
  if (action === 'on' && !id) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/mimic', { userId: id, action });
}

// ── Dreact ────────────────────────────────────────────────────────────────────
function dreactAction(action) {
  const uid   = document.getElementById('dreactUserId').value.trim();
  const emojis = document.getElementById('dreactEmojis').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/dreact', { userId: uid, emojis, action });
}

// ── Autoreact ─────────────────────────────────────────────────────────────────
function autoreactAction(action) {
  const uid   = document.getElementById('autoreactUserId').value.trim();
  const emoji = document.getElementById('autoreactEmoji').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/autoreact', { userId: uid, emoji, action });
}

// ── Autoflood ─────────────────────────────────────────────────────────────────
function autofloodAction(action) {
  const uid = document.getElementById('autofloodUserId').value.trim();
  const msg = document.getElementById('autofloodMsg').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/autoflood', { userId: uid, message: msg, action });
}

// ── Blackify ──────────────────────────────────────────────────────────────────
function blackifyAction(action) {
  const uid = document.getElementById('blackifyUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/blackify', { userId: uid, action });
}

// ── Anti-AFK ──────────────────────────────────────────────────────────────────
function antiAfkAction(action) {
  const uid = document.getElementById('antiAfkUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/antiafk', { userId: uid, action });
}

// ── Ghost ping ────────────────────────────────────────────────────────────────
function ghostpingAction() {
  const uid   = document.getElementById('ghostpingUserId').value.trim();
  const count = parseInt(document.getElementById('ghostpingCount')?.value) || 1;
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/ghostping', { userId: uid, count });
}

// ── Profile ───────────────────────────────────────────────────────────────────
function setProfile(type) {
  const map = { pfp:'pfpUrl', banner:'bannerUrl', name:'displayName', bio:'bioText' };
  const val = document.getElementById(map[type])?.value.trim();
  if (!val) return showToast('Enter a value', false);
  efApi('/api/extra-features/profile', { type, value: val });
}
function stealPfp() {
  const uid = document.getElementById('stealPfpUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/stealpfp', { userId: uid });
}
function setPronouns() {
  const p = document.getElementById('pronounsText').value.trim();
  efApi('/api/extra-features/pronouns', { pronouns: p });
}
function setHypesquad(house) {
  efApi('/api/extra-features/hypesquad', { house });
}

// ── Status ────────────────────────────────────────────────────────────────────
function setStatus(status) {
  efApi('/api/extra-features/setstatus', { status });
}
function statusRotate(action) {
  const statuses = document.getElementById('statusList').value.trim();
  const delay    = parseInt(document.getElementById('statusDelay').value) || 8;
  efApi('/api/extra-features/status-rotator', { statuses, delay, action });
}

// ── Friend / Block ────────────────────────────────────────────────────────────
function friendAction(action) {
  const uid = document.getElementById('friendUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/friend', { userId: uid, action });
}
function blockAction(action) {
  const uid = document.getElementById('blockUserId').value.trim();
  if (!uid) return showToast('Enter a User ID', false);
  efApi('/api/extra-features/block', { userId: uid, action });
}

// ── Token lookup ──────────────────────────────────────────────────────────────
async function tokenLookup() {
  const tok = document.getElementById('tokenInput').value.trim();
  if (!tok) return showToast('Enter a token or position', false);
  const r   = await efApi('/api/extra-features/tinfo', { token: tok });
  const box = document.getElementById('tokenResult');
  if (r.success && r.user) {
    const u = r.user;
    box.textContent = `Username: ${u.username}\nID: ${u.id}\nEmail: ${u.email || 'N/A'}\nNitro: ${u.nitro || 'None'}\nMFA: ${u.mfa}\nPhone: ${u.phone || 'None'}\nVerified: ${u.verified}`;
    box.style.display = 'block';
  } else {
    box.textContent = r.error || 'Invalid or failed.';
    box.style.display = 'block';
  }
}

// ── Nuke action (sends command with server ID context) ─────────────────────────
function nukeAction(cmd, serverId) {
  if (!serverId || !serverId.trim()) return showToast('Enter a Server ID first', false);
  sendCmd(cmd + ' ' + serverId.trim());
}

// ── Environment change ────────────────────────────────────────────────────────
async function setEnv(key, value) {
  if (!key) return;
  if (!value || !value.trim()) return showToast('Enter a value', false);
  const r = await efApi('/api/env/set', { key, value: value.trim() });
  const box = document.getElementById('envResult');
  if (r.success) {
    box.textContent = `✓ ${key} updated. Restart the bot for changes to take effect.`;
    box.style.display = 'block';
    showToast(`${key} saved ✓`);
  } else {
    box.textContent = r.error || 'Failed to update .env';
    box.style.display = 'block';
  }
}

loadState();
</script>
</body>
</html>

