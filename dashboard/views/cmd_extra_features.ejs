      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <% ['ecchi','hentai','uniform','maid','oppai','selfies','raiden','marin'].forEach(c => { %>
          <span class="row-cmd">.<%= c %></span>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- ── 13. TEXT / PURGE ── -->
  <div class="section searchable" data-keywords="purge delete messages ss send silent ghost s sd se ss ssd bold italic strong">
    <div class="section-title section-toggle" onclick="toggleSection(this)">💬 Message Tools (use in Discord chat) <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <% ['.s <text>','`.ss <text>`','.sd <secs> <text>','.se <edit>','.ssd <secs> <text>','.purge [n]','.ghostping @u [n]','.ghostspam @u [n]','.sp <text>','.bomber <text>','.firstmessage','.cls','.me <text>','.bold','.unbold','.italicon','.italicoff','.strongon','.strongoff','.hashon','.hashoff'].forEach(c => { %>
          <span class="row-cmd" style="cursor:default"><%= c %></span>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- ── 14. TWEET / SOCIAL ── -->
  <div class="section searchable" data-keywords="tweet spotify discordreport social">
    <div class="section-title section-toggle" onclick="toggleSection(this)">📢 Social / Misc (use in Discord chat) <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <% ['.tweet <text>','.spotify <song>','.discordreport <uid>','.tinfo [token]','.tbio <tok> <bio>','.tpfp <tok> <url>','.tstatus <tok> <status>','.tpronouns <tok> <text>','.tokuser <token>','.tc <token>','.gentoken [n]','.rg','.rge','.rgd','.tjoin <invite> [n]','.sgcwl <uid>','.gcwl <uid>','.gcfill','.rpcrun','.stoprpc'].forEach(c => { %>
          <span class="row-cmd" style="cursor:default"><%= c %></span>
        <% }); %>
