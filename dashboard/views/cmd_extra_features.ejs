  </div>

  <!-- ── 10. SERVER TOOLS ── -->
  <div class="section searchable" data-keywords="massban masskick massrole channel create nuke server gc leave gcleave srvc serverinfo">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🏰 Server Tools <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div class="row"><div class="row-info"><div class="row-name">Create Channel</div><span class="row-cmd">.createchannel &lt;name&gt;</span></div><div class="row-desc" style="color:#555">Use in Discord chat</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Create VC</div><span class="row-cmd">.createvc &lt;name&gt;</span></div><div class="row-desc" style="color:#555">Use in Discord chat</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Create Role</div><span class="row-cmd">.createrole &lt;name&gt;</span></div><div class="row-desc" style="color:#555">Use in Discord chat</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Mass Ban</div><span class="row-cmd">.massban</span></div><div class="row-desc" style="color:#e74c3c">⚠️ Bans all non-bot members. Irreversible.</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Mass Kick</div><span class="row-cmd">.masskick</span></div><div class="row-desc" style="color:#f39c12">Kicks all non-bot members</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Mass Delete Emojis</div><span class="row-cmd">.massdelemoji / .wipemojis</span></div><div class="row-desc" style="color:#555">Deletes all server emojis</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Leave All Group Chats</div><span class="row-cmd">.gcleaveall</span></div><div class="row-desc" style="color:#555">Leave every group DM</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Server Prune (7 days)</div><span class="row-cmd">.srvprune</span></div><div class="row-desc" style="color:#555">Prune inactive members</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Server Info</div><span class="row-cmd">.srvc</span></div><div class="row-desc" style="color:#555">Show server stats</div></div>
      <div class="row"><div class="row-info"><div class="row-name">Nuke Channel</div><span class="row-cmd">.nukechannel &lt;name&gt;</span></div><div class="row-desc" style="color:#e74c3c">⚠️ Deletes + recreates current channel</div></div>
    </div>
  </div>

  <!-- ── 11. FUN COMMANDS ── -->
  <div class="section searchable" data-keywords="fun pp gay sigma rizz aura skibidi ping diddy pedophile goat cringe godly retard insult waifu sadcat">
    <div class="section-title section-toggle" onclick="toggleSection(this)">😂 Fun Commands (use in Discord chat) <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div style="display:flex;flex-wrap:wrap;gap:6px;padding:4px 0">
        <% const funCmds = ['ping','pp','gay','sigma','rizz','aura','skibidi','diddy','pedophile','goat','faggot','cringe','godly','nitro','hindu','ceepeelover','retard','autism','rape','anal','bangmom','blowjob','boobs','tits','cuck','cum','cumslut','dahoodian','dripcheck','eboy','egirl','femboy','thug','roadman','robloxian','jew','indian','comboy','swat','stomp','spit','tickle','whois','av','snipe','waifu','sadcat','hostinfo','stats','display','menu','help','ip']; %>
        <% funCmds.forEach(c => { %>
          <span class="row-cmd" style="cursor:default">.<%= c %></span>
        <% }); %>
      </div>
      <div style="margin-top:10px;font-size:.76rem;color:#444">All fun commands accept <code>@user</code> as argument. Use them directly in Discord with your bot prefix.</div>
    </div>
  </div>

  <!-- ── 12. ANIME GIFs ── -->
  <div class="section searchable" data-keywords="anime gif sfw nsfw kiss slap hug pat waifu ecchi hentai">
    <div class="section-title section-toggle" onclick="toggleSection(this)">🎌 Anime GIFs (use in Discord chat) <span class="chevron open">▼</span></div>
    <div class="section-body">
      <div style="margin-bottom:8px;font-size:.8rem;color:#555">SFW:</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <% ['kiss','slap','hug','pat','wave','cuddle','lick','bite','bully','poke','bonk','yeet','highfive','handhold','nom','smug','dance','cry','sleep','blush','wink','smile'].forEach(c => { %>
          <span class="row-cmd">.<%= c %></span>
