<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - PRO+</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        .container { width: 95%; max-width: 800px; margin: 40px auto 120px; }
        .page-header { text-align: center; margin-bottom: 40px; }
        .page-header h1 { font-size: 2.5rem; background: linear-gradient(135deg, #fff, #a29bfe); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .section-card { background: #111116; border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 30px; margin-bottom: 25px; }
        .section-title { font-size: 1.1rem; color: #a29bfe; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 10px; margin-bottom: 20px; }
        .input-group { margin-bottom: 20px; }
        .input-label { display: block; color: #ccc; font-size: .9rem; font-weight: 600; margin-bottom: 8px; }
        .input-field { width: 100%; padding: 12px; background: #050508; border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 10px; outline: none; font-family: 'Outfit', sans-serif; transition: .3s; }
        .input-field:focus { border-color: #8a2be2; }
        .btn-save { width: 100%; padding: 15px; font-size: 1.1rem; font-weight: 700; background: linear-gradient(90deg, #8a2be2, #6c5ce7); border: none; border-radius: 12px; color: #fff; cursor: pointer; transition: .3s; }
        .btn-save:hover { filter: brightness(1.15); }
        .back-btn { position: absolute; top: 30px; left: 30px; color: rgba(255,255,255,0.5); text-decoration: none; font-size: 1rem; display: flex; align-items: center; gap: 5px; transition: .3s; }
        .back-btn:hover { color: #fff; }
        .warning { background: rgba(243,156,18,0.1); border: 1px solid rgba(243,156,18,0.3); border-radius: 10px; padding: 15px; color: #f39c12; font-size: .9rem; margin-top: 10px; }
    </style>
</head>
<body>
    <a href="/commands" class="back-btn">← Back</a>

    <div class="container">
        <div class="page-header">
            <h1>⚙️ Settings</h1>
            <p style="color:#888;">Manage bot configuration and environment variables</p>
        </div>

        <div class="section-card">
            <div class="section-title">🔧 Bot Configuration</div>
            
            <div class="input-group">
                <label class="input-label">Command Prefix</label>
                <input type="text" id="inputPrefix" class="input-field" placeholder="." maxlength="3">
                <p class="warning">⚠️ Changing prefix requires bot restart to take full effect</p>
            </div>

            <div class="input-group">
                <label class="input-label">OpenAI API Key (Optional)</label>
                <input type="password" id="inputOpenAI" class="input-field" placeholder="sk-...">
                <p style="color:#888; font-size: .85rem; margin-top: 5px;">Required for AI chat and image generation features</p>
            </div>

            <button id="btnSave" class="btn-save" onclick="saveSettings()">Save Settings</button>
        </div>

        <div class="section-card">
            <div class="section-title">📝 Current Configuration</div>
            <div id="currentConfig" style="font-family: monospace; color: #888; font-size: .9rem;">
                Loading...
            </div>
        </div>
    </div>

    <%- include('partials/super_button') %>

    <script>
        async function loadSettings() {
            try {
                const res = await fetch('/api/settings');
                const data = await res.json();
                
                document.getElementById('inputPrefix').value = data.PREFIX || '.';
                document.getElementById('inputOpenAI').value = data.OPENAI_API_KEY ? '••••••••' : '';
                
                let configHtml = '';
                configHtml += `PREFIX: ${data.PREFIX || '.'}<br>`;
                configHtml += `OPENAI_API_KEY: ${data.OPENAI_API_KEY ? 'Set (hidden)' : 'Not set'}<br>`;
                configHtml += `DISCORD_TOKEN: Hidden for security<br>`;
                
                document.getElementById('currentConfig').innerHTML = configHtml;
            } catch (e) {
                console.error('Error loading settings', e);
            }
        }

        async function saveSettings() {
            const btn = document.getElementById('btnSave');
            const origText = btn.innerText;
            btn.innerText = 'Saving...';
            btn.disabled = true;

            const prefix = document.getElementById('inputPrefix').value.trim() || '.';
            let openaiKey = document.getElementById('inputOpenAI').value.trim();
            
            // Don't update if placeholder dots
            if (openaiKey === '••••••••') openaiKey = null;

            try {
                const res = await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ PREFIX: prefix, OPENAI_API_KEY: openaiKey })
                });

                if (res.ok) {
                    btn.innerText = 'Saved!';
                    btn.style.background = 'linear-gradient(90deg, #2ecc71, #27ae60)';
                    await loadSettings();
                } else {
                    btn.innerText = 'Error!';
                }
            } catch (e) {
                console.error('Error saving settings', e);
                btn.innerText = 'Error!';
            }

            setTimeout(() => {
                btn.innerText = origText;
                btn.disabled = false;
                btn.style.background = 'linear-gradient(90deg, #8a2be2, #6c5ce7)';
            }, 2000);
        }

        window.onload = loadSettings;
    </script>
</body>
</html>
