<!-- ── Pre-Login Floating Menu (shown on /login before authentication) ── -->
<div class="super-button-wrapper" id="preLoginMenuWrapper">
    <div class="super-menu" id="preLoginMenu">
        <div class="menu-header">PRO+ Hub</div>

        <div class="menu-section-label">Quick Access</div>

        <a href="/accounts" class="menu-item">
            <span class="icon">👤</span>
            <span class="label">Login Accounts</span>
        </a>

        <a href="/commands/updater" class="menu-item">
            <span class="icon">🔄</span>
            <span class="label">Updater</span>
        </a>

        <div class="menu-version" id="preLoginMenuVersion">v1.1.1.1b</div>
    </div>

    <button class="super-btn" id="preLoginBtn" onclick="togglePreLoginMenu()"
        style="background: transparent !important; box-shadow: none !important; padding: 0; -webkit-tap-highlight-color: transparent; outline: none;">
        <img src="/super.png" alt="Menu" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;">
    </button>
</div>

<div class="super-overlay" id="preLoginOverlay" onclick="togglePreLoginMenu()"></div>

<style>
/* ── Pre-login menu section label ───────────────────────────────────────────── */
.menu-section-label {
    font-size: .65rem;
    font-weight: 800;
    color: #444;
    text-transform: uppercase;
    letter-spacing: .7px;
    padding: 8px 16px 4px;
}
</style>

<script>
    function togglePreLoginMenu() {
        const menu    = document.getElementById('preLoginMenu');
        const btn     = document.getElementById('preLoginBtn');
        const overlay = document.getElementById('preLoginOverlay');
        menu.classList.toggle('open');
        btn.classList.toggle('active');
        overlay.classList.toggle('visible');
    }

    // Load live version
    (async function() {
        try {
            const r  = await fetch('/api/updater/dot-status').then(x => x.json());
            const el = document.getElementById('preLoginMenuVersion');
            if (el && r.installedVersion) el.textContent = 'v' + r.installedVersion;
        } catch(e) {}
    })();
</script>
<%#- v2.2.2a %>
